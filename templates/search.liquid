<div class="wrap" style="padding-top:56px;padding-bottom:88px">
  <h1 class="serif" style="font-size:42px;margin:0 0 24px">Pesquisar</h1>
  <form action="{{ routes.search_url }}" method="get" style="display:flex;gap:12px;max-width:520px;margin-bottom:48px">
    <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Pesquisar produtos" style="flex:1;border:1.5px solid #E0DACB;border-radius:999px;padding:14px 24px;font-family:var(--sans);font-size:15px;background:#fff;outline:none">
    <button type="submit" class="btn btn--primary">Pesquisar</button>
  </form>
  {% if search.performed %}
    {% paginate search.results by 12 %}
      <div class="prod-grid">
        {% for item in search.results %}
          {% if item.object_type == 'product' %}{% render 'product-card', card_product: item, white: true %}{% endif %}
        {% endfor %}
      </div>
      {% render 'pagination', paginate: paginate %}
    {% endpaginate %}
  {% endif %}
</div>