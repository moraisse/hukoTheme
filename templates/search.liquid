<div class="wrap" style="padding-top:28px;padding-bottom:88px">
  {% if search.performed %}
    <h1 class="serif" style="font-size:42px;margin:0 0 8px">Resultados para “{{ search.terms | escape }}”</h1>
    <p style="margin:0 0 32px;font-size:15.5px;color:var(--muted);font-weight:300">
      {{ search.results_count }} {% if search.results_count == 1 %}resultado{% else %}resultados{% endif %}
    </p>
  {% else %}
    <h1 class="serif" style="font-size:42px;margin:0 0 24px">Pesquisar</h1>
  {% endif %}

  <form action="{{ routes.search_url }}" method="get" role="search" style="display:flex;gap:12px;max-width:520px;margin-bottom:48px">
    <input type="hidden" name="type" value="product">
    <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Pesquisar produtos" aria-label="Pesquisar produtos" style="flex:1;border:1.5px solid #E0DACB;border-radius:999px;padding:14px 24px;font-family:var(--sans);font-size:15px;background:#fff;outline:none">
    <button type="submit" class="btn btn--primary">Pesquisar</button>
  </form>

  {% if search.performed %}
    {% if search.results_count == 0 %}
      <p class="rte">Não encontrámos nada para “{{ search.terms | escape }}”. Experimenta outra palavra ou explora as categorias do menu.</p>
      <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary" style="margin-top:24px">Ver todos os produtos</a>
    {% else %}
      {% paginate search.results by 12 %}
        <div class="prod-grid">
          {% for item in search.results %}
            {% if item.object_type == 'product' %}{% render 'product-card', card_product: item, white: true %}{% endif %}
          {% endfor %}
        </div>
        {% render 'pagination', paginate: paginate %}
      {% endpaginate %}
    {% endif %}
  {% endif %}
</div>
