{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign initial_title = current_variant.metafields.huko.variant_title.value | default: product.title -%}
{%- assign initial_desc = current_variant.metafields.huko.variant_description.value | default: product.description -%}
<div class="wrap">
  <nav class="breadcrumb"><a href="{{ routes.root_url }}">Início</a><em>/</em>{% if collection %}<a href="{{ collection.url }}">{{ collection.title }}</a><em>/</em>{% endif %}<span>{{ product.title }}</span></nav>
  <div class="pdp">
    <div>
      {%- assign featured = current_variant.featured_image | default: product.featured_image -%}
      <div class="pdp__main">{% if featured %}<img src="{{ featured | image_url: width: 1200 }}" alt="{{ featured.alt | split: '#variant:' | first | strip | escape }}" id="MainImage">{% endif %}</div>
      {% if product.images.size > 1 %}
        {%- comment -%}
          Imagens com tag "#variant:<valor>" no alt pertencem a essa variante
          (option1/cor) e só aparecem quando ela está selecionada; imagens sem
          tag são comuns a todas. A tag é retirada do alt renderizado.
        {%- endcomment -%}
        <div class="pdp__thumbs" id="Thumbs">
          {% for image in product.images %}
            {%- assign alt_parts = image.alt | split: '#variant:' -%}
            {%- assign vtag = '' -%}
            {%- if alt_parts.size > 1 -%}{%- assign vtag = alt_parts[1] | strip -%}{%- endif -%}
            {%- assign clean_alt = alt_parts[0] | strip | default: product.title -%}
            {%- assign visible = true -%}
            {%- if vtag != '' and vtag != current_variant.option1 -%}{%- assign visible = false -%}{%- endif -%}
            <img src="{{ image | image_url: width: 300 }}" alt="{{ clean_alt | escape }}" loading="lazy"
                 {% if vtag != '' %}data-variant-tag="{{ vtag | escape }}"{% endif %}
                 data-full="{{ image | image_url: width: 1200 }}"
                 {% unless visible %}style="display:none"{% endunless %}
                 onclick="document.getElementById('MainImage').src=this.dataset.full">
          {% endfor %}
        </div>
      {% endif %}
    </div>
    <div class="pdp__buy">
      <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap">
        {% if product.tags contains 'mais-vendido' %}<span class="badge badge--best" style="position:static">Mais vendido</span>{% endif %}
        {% if product.tags contains 'novo' %}<span class="badge badge--new" style="position:static">Novo</span>{% endif %}
        <span class="stars" style="font-size:14px">★★★★★ <span>4,9</span></span>
      </div>
      <h1 id="ProductTitle">{{ initial_title }}</h1>
      <p class="lead" id="ProductLead">{{ initial_desc | strip_html | truncate: 180 }}</p>
      <div style="display:flex;align-items:baseline;gap:14px">
        <span class="price price--big" id="ProductPrice">{{ current_variant.price | money }}</span>
        {% if product.available %}<span class="stock">Em stock · envio em 24h</span>{% endif %}
      </div>
      {% form 'product', product %}
        {% unless product.has_only_default_variant %}
          {% for option in product.options_with_values %}
            <div style="margin-bottom:18px">
              <span class="opt-label">{{ option.name }}</span>
              <div class="variant-btns">
                {% for value in option.values %}
                  {% assign oid = 'opt-' | append: option.position | append: '-' | append: forloop.index %}
                  <input type="radio" id="{{ oid }}" name="options[{{ option.name | escape }}]" value="{{ value | escape }}" {% if option.selected_value == value %}checked{% endif %}>
                  <label for="{{ oid }}">{{ value }}</label>
                {% endfor %}
              </div>
            </div>
          {% endfor %}
        {% endunless %}
        <input type="hidden" name="id" id="VariantId" value="{{ current_variant.id }}">
        <div class="qty-cart">
          <div class="qty">
            <button type="button" onclick="var q=document.getElementById('Qty');q.value=Math.max(1,+q.value-1)">−</button>
            <input id="Qty" type="text" name="quantity" value="1">
            <button type="button" onclick="var q=document.getElementById('Qty');q.value=+q.value+1">+</button>
          </div>
          <button type="submit" class="btn btn--primary" style="flex:1" id="AddToCart" {% unless product.available %}disabled{% endunless %}>
            {% if product.available %}Adicionar ao carrinho — {{ current_variant.price | money }}{% else %}Esgotado{% endif %}
          </button>
        </div>
      {% endform %}
      <div class="trust">
        <div><svg width="24" height="24" viewBox="0 0 34 34" fill="none" stroke="#2ECC71" stroke-width="1.8"><rect x="4" y="10" width="17" height="12" rx="1.5"/><path d="M21 14h5l4 4v4h-9"/><circle cx="10" cy="25" r="2.6"/><circle cx="25" cy="25" r="2.6"/></svg>Envio 24–48h</div>
        <div><svg width="24" height="24" viewBox="0 0 34 34" fill="none" stroke="#2ECC71" stroke-width="1.8"><path d="M17 5 6 9v8c0 7 4.8 11 11 13 6.2-2 11-6 11-13V9l-11-4z"/></svg>Pagamento seguro</div>
        <div><svg width="24" height="24" viewBox="0 0 34 34" fill="none" stroke="#2ECC71" stroke-width="1.8"><path d="M9 13 5 17l4 4"/><path d="M5 17h16a8 8 0 1 0-1.5-8"/></svg>Devolução 30 dias</div>
      </div>
      <div class="acc"><strong>Descrição</strong><div class="rte" id="ProductDesc" style="font-size:15px">{{ initial_desc }}</div></div>
    </div>
  </div>
</div>

{%- comment -%}
  Seleção de variante: os radios não fazem nada sozinhos — este bloco sincroniza
  o input escondido "id", o preço, o botão, e troca título/descrição (metafields
  huko.variant_title / huko.variant_description, escritos pelo importador) e as
  imagens da cor selecionada (tag "#variant:" no alt, ver galeria acima).
{%- endcomment -%}
<script type="application/json" id="VariantData">
{
  "optionNames": {{ product.options | json }},
  "variants": {
    {%- for variant in product.variants -%}
    {{ variant.options | join: ' / ' | json }}: {
      "id": {{ variant.id }},
      "available": {{ variant.available }},
      "option1": {{ variant.option1 | json }},
      "price": {{ variant.price | money | json }},
      "title": {{ variant.metafields.huko.variant_title.value | default: product.title | json }},
      "description": {{ variant.metafields.huko.variant_description.value | default: product.description | json }}
    }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  }
}
</script>
<script>
(function(){
  var dataEl = document.getElementById('VariantData');
  if (!dataEl) return;
  var data;
  try { data = JSON.parse(dataEl.textContent); } catch(e){ return; }

  function selectedKey(){
    var values = [];
    for (var i = 0; i < data.optionNames.length; i++) {
      var checked = document.querySelector('input[name="options[' + data.optionNames[i] + ']"]:checked');
      if (!checked) return null;
      values.push(checked.value);
    }
    return values.join(' / ');
  }

  function filterGallery(option1){
    var thumbs = document.querySelectorAll('#Thumbs img');
    var first = null;
    thumbs.forEach(function(t){
      var tag = t.getAttribute('data-variant-tag');
      var show = !tag || !option1 || tag === option1;
      t.style.display = show ? '' : 'none';
      if (show && !first) first = t;
    });
    var main = document.getElementById('MainImage');
    if (main && first) main.src = first.dataset.full;
  }

  function apply(){
    var key = selectedKey();
    var v = key !== null ? data.variants[key] : null;
    if (!v) return;
    var id = document.getElementById('VariantId');
    if (id) id.value = v.id;
    var price = document.getElementById('ProductPrice');
    if (price) price.textContent = v.price;
    var btn = document.getElementById('AddToCart');
    if (btn) {
      btn.disabled = !v.available;
      btn.textContent = v.available ? 'Adicionar ao carrinho — ' + v.price : 'Esgotado';
    }
    var title = document.getElementById('ProductTitle');
    if (title && v.title) title.textContent = v.title;
    if (v.description) {
      var desc = document.getElementById('ProductDesc');
      if (desc) desc.innerHTML = v.description;
      var lead = document.getElementById('ProductLead');
      if (lead) {
        var tmp = document.createElement('div');
        tmp.innerHTML = v.description;
        var text = (tmp.textContent || '').trim();
        lead.textContent = text.length > 180 ? text.slice(0, 177) + '…' : text;
      }
    }
    filterGallery(v.option1);
  }

  document.querySelectorAll('.variant-btns input[type="radio"]').forEach(function(radio){
    radio.addEventListener('change', apply);
  });
})();
</script>

{% assign rel = collections.all %}
{% if collection %}{% assign rel = collection %}{% endif %}
{% if rel.products.size > 1 %}
<section class="section section--card">
  <div class="wrap">
    <h2 class="serif" style="font-size:32px;margin:0 0 36px">Combina bem com</h2>
    <div class="prod-grid">
      {% assign shown = 0 %}
      {% for p in rel.products %}
        {% if p.id != product.id and shown < 4 %}
          {% render 'product-card', card_product: p %}
          {% assign shown = shown | plus: 1 %}
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}
