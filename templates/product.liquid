{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign initial_title = current_variant.metafields.huko.variant_title.value | default: product.title -%}
{%- assign initial_desc = current_variant.metafields.huko.variant_description.value | default: product.description -%}
<div class="wrap">
  <div class="pdp">
    <div>
      {%- assign featured = current_variant.featured_image | default: product.featured_image -%}
      <div class="pdp__gallery">
        <div class="pdp__main" id="MainImageWrap" role="button" tabindex="0" aria-label="Ampliar imagem">
          {% if product.tags contains 'mais-vendido' %}<span class="badge badge--best">Mais vendido</span>{% endif %}
          {% if product.tags contains 'novo' %}<span class="badge badge--new" style="top:{% if product.tags contains 'mais-vendido' %}50{% else %}14{% endif %}px">Novo</span>{% endif %}
          {% if featured %}<img src="{{ featured | image_url: width: 1200 }}" alt="{{ featured.alt | split: '#variant:' | first | strip | escape }}" id="MainImage">{% endif %}
        </div>
        {% if product.images.size > 1 %}
          <button type="button" class="pdp__arrow pdp__arrow--prev" id="GalleryPrev" aria-label="Foto anterior">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
          </button>
          <button type="button" class="pdp__arrow pdp__arrow--next" id="GalleryNext" aria-label="Foto seguinte">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
          </button>
          <div class="pdp__counter" id="GalleryCounter"></div>
        {% endif %}
      </div>
      {% if product.images.size > 0 %}
        {%- comment -%}
          Imagens com tag "#variant:<valor>" no alt pertencem a essa variante
          (option1/cor) e só aparecem quando ela está selecionada; imagens sem
          tag são comuns a todas. A tag é retirada do alt renderizado. Os dados
          alimentam o carrossel/lightbox em JS — não há miniaturas visíveis.
        {%- endcomment -%}
        <script type="application/json" id="GalleryData">
        [
          {%- for image in product.images -%}
            {%- assign alt_parts = image.alt | split: '#variant:' -%}
            {%- assign vtag = '' -%}
            {%- if alt_parts.size > 1 -%}{%- assign vtag = alt_parts[1] | strip -%}{%- endif -%}
            {%- assign clean_alt = alt_parts[0] | strip | default: product.title -%}
            {
              "src": {{ image | image_url: width: 1200 | json }},
              "zoom": {{ image | image_url: width: 2200 | json }},
              "alt": {{ clean_alt | json }},
              "variantTag": {{ vtag | json }}
            }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]
        </script>
        <div class="pdp__lightbox" id="Lightbox">
          <button type="button" class="pdp__lightbox-close" id="LightboxClose" aria-label="Fechar">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="6" y1="6" x2="18" y2="18"/><line x1="18" y1="6" x2="6" y2="18"/></svg>
          </button>
          {% if product.images.size > 1 %}
            <button type="button" class="pdp__arrow pdp__arrow--prev" id="LightboxPrev" aria-label="Foto anterior">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
            </button>
            <button type="button" class="pdp__arrow pdp__arrow--next" id="LightboxNext" aria-label="Foto seguinte">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
            </button>
          {% endif %}
          <img src="" alt="" id="LightboxImage">
        </div>
      {% endif %}
    </div>
    <div class="pdp__buy">
      <h1 id="ProductTitle">{{ initial_title }}</h1>
      <p class="lead" id="ProductLead">{{ initial_desc | strip_html | truncate: 180 }}</p>
      <div style="display:flex;align-items:baseline;gap:14px">
        <span class="price price--big" id="ProductPrice">{{ current_variant.price | money }}</span>
        {% if product.available %}<span class="stock">Em stock · envio em 24h</span>{% endif %}
      </div>
      {% form 'product', product %}
        {% unless product.has_only_default_variant %}
          {% for option in product.options_with_values %}
            <div style="margin-bottom:18px">
              <span class="opt-label">{{ option.name }}</span>
              <div class="variant-btns">
                {% for value in option.values %}
                  {% assign oid = 'opt-' | append: option.position | append: '-' | append: forloop.index %}
                  <input type="radio" id="{{ oid }}" name="options[{{ option.name | escape }}]" value="{{ value | escape }}" {% if option.selected_value == value %}checked{% endif %}>
                  <label for="{{ oid }}">{{ value }}</label>
                {% endfor %}
              </div>
            </div>
          {% endfor %}
        {% endunless %}
        <input type="hidden" name="id" id="VariantId" value="{{ current_variant.id }}">
        <div class="qty-cart">
          <div class="qty">
            <button type="button" onclick="var q=document.getElementById('Qty');q.value=Math.max(1,+q.value-1)">−</button>
            <input id="Qty" type="text" name="quantity" value="1">
            <button type="button" onclick="var q=document.getElementById('Qty');q.value=+q.value+1">+</button>
          </div>
          <button type="submit" class="btn btn--primary" style="flex:1" id="AddToCart" {% unless product.available %}disabled{% endunless %}>
            {% if product.available %}Adicionar ao carrinho — {{ current_variant.price | money }}{% else %}Esgotado{% endif %}
          </button>
        </div>
      {% endform %}
      <div class="trust">
        <div><svg width="24" height="24" viewBox="0 0 34 34" fill="none" stroke="#2ECC71" stroke-width="1.8"><rect x="4" y="10" width="17" height="12" rx="1.5"/><path d="M21 14h5l4 4v4h-9"/><circle cx="10" cy="25" r="2.6"/><circle cx="25" cy="25" r="2.6"/></svg>Envio 24–48h</div>
        <div><svg width="24" height="24" viewBox="0 0 34 34" fill="none" stroke="#2ECC71" stroke-width="1.8"><path d="M17 5 6 9v8c0 7 4.8 11 11 13 6.2-2 11-6 11-13V9l-11-4z"/></svg>Pagamento seguro</div>
        <div><svg width="24" height="24" viewBox="0 0 34 34" fill="none" stroke="#2ECC71" stroke-width="1.8"><path d="M9 13 5 17l4 4"/><path d="M5 17h16a8 8 0 1 0-1.5-8"/></svg>Devolução 30 dias</div>
      </div>
    </div>
  </div>
  <div class="pdp__desc">
    <h2 class="serif">Descrição</h2>
    <div class="rte" id="ProductDesc">{{ initial_desc }}</div>
  </div>
</div>

{%- comment -%}
  Seleção de variante: os radios não fazem nada sozinhos — este bloco sincroniza
  o input escondido "id", o preço, o botão, e troca título/descrição (metafields
  huko.variant_title / huko.variant_description, escritos pelo importador) e as
  imagens da cor selecionada (tag "#variant:" no alt, ver galeria acima).
{%- endcomment -%}
<script type="application/json" id="VariantData">
{
  "optionNames": {{ product.options | json }},
  "variants": {
    {%- for variant in product.variants -%}
    {{ variant.options | join: ' / ' | json }}: {
      "id": {{ variant.id }},
      "available": {{ variant.available }},
      "option1": {{ variant.option1 | json }},
      "price": {{ variant.price | money | json }},
      "title": {{ variant.metafields.huko.variant_title.value | default: product.title | json }},
      "description": {{ variant.metafields.huko.variant_description.value | default: product.description | json }}
    }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  }
}
</script>
<script>
(function(){
  var dataEl = document.getElementById('VariantData');
  if (!dataEl) return;
  var data;
  try { data = JSON.parse(dataEl.textContent); } catch(e){ return; }

  function selectedKey(){
    var values = [];
    for (var i = 0; i < data.optionNames.length; i++) {
      var checked = document.querySelector('input[name="options[' + data.optionNames[i] + ']"]:checked');
      if (!checked) return null;
      values.push(checked.value);
    }
    return values.join(' / ');
  }

  function refreshAvailability(){
    var selected = data.optionNames.map(function(name){
      var checked = document.querySelector('input[name="options[' + name + ']"]:checked');
      return checked ? checked.value : null;
    });
    data.optionNames.forEach(function(name, i){
      document.querySelectorAll('input[name="options[' + name + ']"]').forEach(function(radio){
        var testValues = selected.slice();
        testValues[i] = radio.value;
        var v = data.variants[testValues.join(' / ')];
        radio.disabled = !v || !v.available;
      });
    });
  }

  function apply(){
    var key = selectedKey();
    var v = key !== null ? data.variants[key] : null;
    if (!v) return;
    var id = document.getElementById('VariantId');
    if (id) id.value = v.id;
    var price = document.getElementById('ProductPrice');
    if (price) price.textContent = v.price;
    var btn = document.getElementById('AddToCart');
    if (btn) {
      btn.disabled = !v.available;
      btn.textContent = v.available ? 'Adicionar ao carrinho — ' + v.price : 'Esgotado';
    }
    var title = document.getElementById('ProductTitle');
    if (title && v.title) title.textContent = v.title;
    if (v.description) {
      var desc = document.getElementById('ProductDesc');
      if (desc) desc.innerHTML = v.description;
      var lead = document.getElementById('ProductLead');
      if (lead) {
        var tmp = document.createElement('div');
        tmp.innerHTML = v.description;
        var text = (tmp.textContent || '').trim();
        lead.textContent = text.length > 180 ? text.slice(0, 177) + '…' : text;
      }
    }
    if (window.HukoGallery) window.HukoGallery.computeVisible(v.option1);
    refreshAvailability();
  }

  document.querySelectorAll('.variant-btns input[type="radio"]').forEach(function(radio){
    radio.addEventListener('change', apply);
  });

  refreshAvailability();
})();
</script>

{%- comment -%}
  Carrossel da imagem principal (setas, uma imagem de cada vez) + lightbox
  ao clicar. Lê a lista de imagens de "GalleryData" e filtra pela variante
  selecionada (ver bloco de seleção de variante acima).
{%- endcomment -%}
<script>
(function(){
  var galleryEl = document.getElementById('GalleryData');
  if (!galleryEl) return;
  var images;
  try { images = JSON.parse(galleryEl.textContent); } catch(e){ return; }

  var mainImg = document.getElementById('MainImage');
  var mainWrap = document.getElementById('MainImageWrap');
  var prevBtn = document.getElementById('GalleryPrev');
  var nextBtn = document.getElementById('GalleryNext');
  var counterEl = document.getElementById('GalleryCounter');
  var lightbox = document.getElementById('Lightbox');
  var lightboxImg = document.getElementById('LightboxImage');
  var lightboxClose = document.getElementById('LightboxClose');
  var lightboxPrev = document.getElementById('LightboxPrev');
  var lightboxNext = document.getElementById('LightboxNext');

  var visible = images.slice();
  var index = 0;

  function computeVisible(variantTag){
    visible = images.filter(function(img){
      return !img.variantTag || !variantTag || img.variantTag === variantTag;
    });
    if (!visible.length) visible = images.slice(0, 1);
    index = 0;
    render();
  }

  function render(){
    var img = visible[index];
    if (!img) return;
    if (mainImg) { mainImg.src = img.src; mainImg.alt = img.alt; }
    var multi = visible.length > 1;
    if (prevBtn) prevBtn.style.display = multi ? '' : 'none';
    if (nextBtn) nextBtn.style.display = multi ? '' : 'none';
    if (counterEl) {
      counterEl.style.display = multi ? '' : 'none';
      counterEl.textContent = (index + 1) + ' / ' + visible.length;
    }
    if (lightbox && lightbox.classList.contains('is-open')) renderLightbox();
  }

  function step(dir){
    if (!visible.length) return;
    index = (index + dir + visible.length) % visible.length;
    render();
  }

  function renderLightbox(){
    var img = visible[index];
    if (!img || !lightboxImg) return;
    lightboxImg.src = img.zoom;
    lightboxImg.alt = img.alt;
  }

  function openLightbox(){
    if (!lightbox || !visible.length) return;
    renderLightbox();
    lightbox.classList.add('is-open');
    document.body.classList.add('drawer-open');
  }

  function closeLightbox(){
    if (!lightbox) return;
    lightbox.classList.remove('is-open');
    document.body.classList.remove('drawer-open');
  }

  if (prevBtn) prevBtn.addEventListener('click', function(){ step(-1); });
  if (nextBtn) nextBtn.addEventListener('click', function(){ step(1); });
  if (mainWrap) {
    mainWrap.addEventListener('click', openLightbox);
    mainWrap.addEventListener('keydown', function(e){
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openLightbox(); }
    });
  }
  if (lightboxClose) lightboxClose.addEventListener('click', closeLightbox);
  if (lightbox) lightbox.addEventListener('click', function(e){ if (e.target === lightbox) closeLightbox(); });
  if (lightboxPrev) lightboxPrev.addEventListener('click', function(){ step(-1); });
  if (lightboxNext) lightboxNext.addEventListener('click', function(){ step(1); });
  document.addEventListener('keydown', function(e){
    if (!lightbox || !lightbox.classList.contains('is-open')) return;
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowLeft') step(-1);
    if (e.key === 'ArrowRight') step(1);
  });

  window.HukoGallery = { computeVisible: computeVisible };
  computeVisible({{ current_variant.option1 | json }});
})();
</script>

{% assign rel = collections.all %}
{% if collection %}{% assign rel = collection %}{% endif %}
{% if rel.products.size > 1 %}
<section class="section section--card">
  <div class="wrap">
    <h2 class="serif" style="font-size:32px;margin:0 0 36px">Combina bem com</h2>
    <div class="prod-grid">
      {% assign shown = 0 %}
      {% for p in rel.products %}
        {% if p.id != product.id and shown < 4 %}
          {% render 'product-card', card_product: p %}
          {% assign shown = shown | plus: 1 %}
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}
