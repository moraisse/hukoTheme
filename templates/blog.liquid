<div class="wrap" style="max-width:900px;padding-top:56px;padding-bottom:88px">
  <h1 class="serif" style="font-size:42px;margin:0 0 36px">{{ blog.title }}</h1>
  {% for article in blog.articles %}
    <article style="border-top:1px solid var(--line);padding:28px 0">
      <a href="{{ article.url }}" class="serif" style="font-size:26px">{{ article.title }}</a>
      <p class="rte" style="margin:10px 0 0">{{ article.excerpt_or_content | strip_html | truncate: 160 }}</p>
    </article>
  {% endfor %}
</div>