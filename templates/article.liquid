{%- comment -%}
  Artigo do Espaço HUKO. O trilho de navegação (e o BreadcrumbList) e a newsletter
  já vêm do layout. O conteúdo guardado no artigo não é alterado: só se retira o
  bloco <style> antigo na apresentação, para o design ficar a cargo de espaco-huko.css.
{%- endcomment -%}
{{ 'espaco-huko.css' | asset_url | stylesheet_tag }}
<script src="{{ 'espaco-huko.js' | asset_url }}" defer></script>
{%- liquid
  assign body = article.content
  if body contains '</style>'
    assign body = body | split: '</style>' | last
  endif
  assign body = body | replace: '<main class="content">', '<div class="content">' | replace: '</main><aside', '</div><aside' | replace: '<img ', '<img loading="lazy" decoding="async" '

  assign words = article.content | strip_html | split: ' ' | size
  assign minutes = words | divided_by: 200 | at_least: 1
  assign author_name = article.author | default: 'Equipa HUKO pets'
  assign article_url = shop.url | append: article.url
  assign hero_alt = article.image.alt | default: article.title
  assign summary = article.excerpt | strip_html | strip
  assign square = false
  if article.image and article.image.aspect_ratio < 1.25
    assign square = true
  endif
  assign pub_day = article.published_at | date: '%Y%m%d' | plus: 0
  assign upd_day = article.updated_at | date: '%Y%m%d' | plus: 0

  comment
    Produtos ligados no texto (/products/handle), sem repetições, pela ordem em que aparecem.
  endcomment
  assign handles = ''
  assign chunks = article.content | split: '/products/'
  for chunk in chunks offset: 1
    assign h = chunk | split: '"' | first | split: "'" | first | split: '?' | first | split: '#' | first | split: '/' | first | split: '<' | first | strip
    if h == blank or h contains '.' or h contains ' '
      continue
    endif
    assign needle = ',' | append: h | append: ','
    assign hay = handles | append: ','
    unless hay contains needle
      assign handles = handles | append: ',' | append: h
    endunless
  endfor
  assign handles = handles | remove_first: ',' | split: ','
-%}

<div class="eh-progress" aria-hidden="true"><span data-eh-progress></span></div>

<article class="eh eh-art">
  <header class="eh-art__head">
    <div class="wrap">
      <div class="eh-art__headgrid{% unless square %} eh-art__headgrid--wide{% endunless %}">
        <div class="eh-art__intro">
          {%- if article.tags.size > 0 -%}
            <ul class="eh-art__tags">
              {%- for tag in article.tags limit: 2 -%}
                <li><a class="eh-tag" href="{{ blog.url }}/tagged/{{ tag | handle }}">{{ tag }}</a></li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
          <h1 class="eh-art__title">{{ article.title }}</h1>
          {%- if summary != blank -%}<p class="eh-art__lead">{{ summary }}</p>{%- endif -%}
          <div class="eh-art__meta">
            <span class="eh-art__avatar" aria-hidden="true">H</span>
            <span class="eh-art__meta-text">
              <strong>Por {{ author_name }}</strong>
              <span>
                <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: '%d.%m.%Y' }}</time>
                {%- if upd_day > pub_day %} · Atualizado a <time datetime="{{ article.updated_at | date: '%Y-%m-%d' }}">{{ article.updated_at | date: '%d.%m.%Y' }}</time>{% endif %}
                · {{ minutes }} min de leitura
              </span>
            </span>
          </div>
        </div>
        {%- if article.image and square -%}
          <figure class="eh-art__media">
            {{ article.image | image_url: width: 1000 | image_tag: widths: '400, 600, 800, 1000', sizes: '(min-width: 900px) 500px, 92vw', loading: 'eager', fetchpriority: 'high', alt: hero_alt }}
          </figure>
        {%- endif -%}
      </div>
      {%- if article.image and square == false -%}
        <figure class="eh-art__media eh-art__media--wide">
          {{ article.image | image_url: width: 2000 | image_tag: widths: '600, 900, 1200, 1600, 2000', sizes: '(min-width: 1360px) 1280px, 94vw', loading: 'eager', fetchpriority: 'high', alt: hero_alt }}
        </figure>
      {%- endif -%}
    </div>
  </header>

  <div class="wrap eh-art__layout">
    <div class="eh-art__main">
      <details class="eh-box eh-toc eh-toc--mobile" data-eh-toc hidden>
        <summary>Neste artigo</summary>
        <ol data-eh-toc-list></ol>
      </details>

      <div class="eh-body{% if article.image %} eh-body--hasimage{% endif %}" data-eh-body>
        {{ body }}
      </div>

      <footer class="eh-art__foot">
        {%- if article.tags.size > 0 -%}
          <div class="eh-art__row">
            <span class="eh-art__label">Temas</span>
            <ul class="eh-chips">
              {%- for tag in article.tags -%}
                <li><a class="eh-chip" href="{{ blog.url }}/tagged/{{ tag | handle }}">{{ tag }}</a></li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
        {%- assign share_url = article_url | url_encode -%}
        {%- assign share_text = article.title | url_encode -%}
        <div class="eh-art__row">
          <span class="eh-art__label">Partilhar</span>
          <ul class="eh-share">
            <li><a href="https://wa.me/?text={{ share_text }}%20{{ share_url }}" target="_blank" rel="noopener nofollow" aria-label="Partilhar no WhatsApp"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20l1.2-4.1A8.2 8.2 0 1 1 8.4 19z"/></svg></a></li>
            <li><a href="https://www.facebook.com/sharer/sharer.php?u={{ share_url }}" target="_blank" rel="noopener nofollow" aria-label="Partilhar no Facebook"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg></a></li>
            {%- if article.image -%}
              <li><a href="https://pinterest.com/pin/create/button/?url={{ share_url }}&media={{ article.image | image_url: width: 1200 | prepend: 'https:' | url_encode }}&description={{ share_text }}" target="_blank" rel="noopener nofollow" aria-label="Partilhar no Pinterest"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M11 8.5c3.5-.9 5.5 1.3 4.8 3.8-.6 2.2-2.6 3-3.8 2.1M12.4 10.5 10 20"/></svg></a></li>
            {%- endif -%}
            <li><button type="button" data-eh-copy="{{ article_url }}" aria-label="Copiar ligação"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1"/><path d="M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1"/></svg></button></li>
          </ul>
        </div>
        <div class="eh-author">
          <span class="eh-art__avatar" aria-hidden="true">H</span>
          <div>
            <strong>{{ author_name }}</strong>
            <p>Selecionamos cada produto da loja e escrevemos estes guias para ajudar a escolher com confiança. Dúvidas? Fale connosco pelo <a href="https://wa.me/351931198604" target="_blank" rel="noopener">WhatsApp</a>.</p>
          </div>
        </div>
      </footer>
    </div>

    <aside class="eh-art__aside" aria-label="Neste artigo">
      <nav class="eh-box eh-toc" data-eh-toc hidden>
        <p class="eh-box__title">Neste artigo</p>
        <ol data-eh-toc-list></ol>
      </nav>
      {%- if handles.size > 0 -%}
        <div class="eh-box">
          <p class="eh-box__title">Produtos neste guia</p>
          <div class="eh-buy">
            {%- assign shown = 0 -%}
            {%- for h in handles -%}
              {%- assign p = all_products[h] -%}
              {%- if p.id == blank or shown >= 3 -%}{%- continue -%}{%- endif -%}
              {%- assign shown = shown | plus: 1 -%}
              {%- assign v = p.selected_or_first_available_variant -%}
              <a href="{{ p.url }}">
                <span class="eh-buy__img">{%- if p.featured_image -%}<img src="{{ p.featured_image | image_url: width: 160 }}" alt="" width="60" height="60" loading="lazy">{%- endif -%}</span>
                <span>
                  <span class="eh-buy__name">{{ p.title }}</span>
                  {%- if v.compare_at_price > v.price -%}
                    <span class="eh-buy__sale"><span class="visually-hidden">Desconto de </span>-{{ v.compare_at_price | minus: v.price | times: 100.0 | divided_by: v.compare_at_price | round }}%</span>
                  {%- endif -%}
                  <span class="eh-buy__price">{{ v.price | money }}</span>
                </span>
              </a>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    </aside>
  </div>
</article>

{%- if handles.size > 0 -%}
  <section class="eh eh-section eh-section--white">
    <div class="wrap">
      <div class="eh-head">
        <div>
          <p class="eh-kicker">Do guia à escolha certa</p>
          <h2 class="eh-h2">Produtos referidos neste artigo</h2>
        </div>
      </div>
      <div class="prod-grid">
        {%- assign shown = 0 -%}
        {%- for h in handles -%}
          {%- assign p = all_products[h] -%}
          {%- if p.id == blank or shown >= 4 -%}{%- continue -%}{%- endif -%}
          {%- assign shown = shown | plus: 1 -%}
          {% render 'product-card', card_product: p, white: true %}
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{%- liquid
  assign related_ids = ''
  assign related_count = 0
  assign first_tag = article.tags.first
  if first_tag
    for a in blog.articles
      if a.id == article.id or related_count >= 3
        continue
      endif
      if a.tags contains first_tag
        assign related_ids = related_ids | append: ',' | append: a.id | append: ','
        assign related_count = related_count | plus: 1
      endif
    endfor
  endif
  for a in blog.articles
    if a.id == article.id or related_count >= 3
      continue
    endif
    assign needle = ',' | append: a.id | append: ','
    unless related_ids contains needle
      assign related_ids = related_ids | append: needle
      assign related_count = related_count | plus: 1
    endunless
  endfor
-%}
{%- if related_count > 0 -%}
  <section class="eh eh-section">
    <div class="wrap">
      <div class="eh-head">
        <div>
          <p class="eh-kicker">Continue a ler</p>
          <h2 class="eh-h2">Mais guias do Espaço HUKO</h2>
        </div>
        <a class="eh-more" href="/pages/espaco-huko">Ver todos →</a>
      </div>
      <ul class="eh-grid">
        {%- for a in blog.articles -%}
          {%- assign needle = ',' | append: a.id | append: ',' -%}
          {%- if related_ids contains needle -%}
            <li>{% render 'eh-article-card', article: a, heading: 'h3', excerpt: true %}</li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  </section>
{%- endif -%}

{%- liquid
  if settings.logo != blank
    assign publisher_logo = settings.logo | image_url: width: 600 | prepend: 'https:'
  else
    assign publisher_logo = 'logo-huko.png' | asset_url | prepend: 'https:'
  endif
  assign description = summary | default: body | strip_html | strip_newlines | strip | truncate: 300
-%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "@id": {{ article_url | append: '#article' | json }},
    "mainEntityOfPage": { "@type": "WebPage", "@id": {{ article_url | json }} },
    "url": {{ article_url | json }},
    "headline": {{ article.title | truncate: 110 | json }},
    "description": {{ description | json }},
    {%- if article.image %}
    "image": [
      {{ article.image | image_url: width: 1200, height: 1200, crop: 'center' | prepend: 'https:' | json }},
      {{ article.image | image_url: width: 1200, height: 900, crop: 'center' | prepend: 'https:' | json }},
      {{ article.image | image_url: width: 1200, height: 675, crop: 'center' | prepend: 'https:' | json }}
    ],
    {%- endif %}
    "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%:z' | json }},
    "dateModified": {{ article.updated_at | date: '%Y-%m-%dT%H:%M:%S%:z' | json }},
    "author": { "@type": "Organization", "name": {{ author_name | json }}, "url": {{ shop.url | append: '/pages/espaco-huko' | json }} },
    "publisher": { "@type": "Organization", "name": "HUKO pets", "url": "https://hukopets.com/", "logo": { "@type": "ImageObject", "url": {{ publisher_logo | json }} } },
    "isPartOf": { "@type": "Blog", "name": {{ blog.title | json }}, "url": {{ shop.url | append: blog.url | json }} },
    {%- if article.tags.size > 0 %}
    "articleSection": {{ article.tags.first | json }},
    "keywords": {{ article.tags | join: ', ' | json }},
    {%- endif %}
    {%- if handles.size > 0 %}
    "mentions": [
      {%- assign first_mention = true -%}
      {%- for h in handles limit: 4 -%}
        {%- assign p = all_products[h] -%}
        {%- if p.id == blank -%}{%- continue -%}{%- endif -%}
        {%- unless first_mention -%},{%- endunless -%}
        { "@type": "Product", "name": {{ p.title | json }}, "url": {{ shop.url | append: p.url | json }}{% if p.vendor != blank %}, "brand": { "@type": "Brand", "name": {{ p.vendor | json }} }{% endif %} }
        {%- assign first_mention = false -%}
      {%- endfor -%}
    ],
    {%- endif %}
    "wordCount": {{ words }},
    "inLanguage": "pt-PT"
  }
</script>
