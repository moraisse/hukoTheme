<div class="auth">
  <div class="auth__card">
    <div class="auth__form">
      <section class="auth__pane">
        <h1 class="serif auth__title">Nova palavra-passe</h1>
        <p class="auth__sub">Escolha uma palavra-passe para voltar a entrar na sua conta.</p>

        {% form 'reset_customer_password' %}
          {% if form.errors %}
            <ul class="auth-notice auth-notice--error">
              {% for field in form.errors %}<li>{{ form.errors.messages[field] }}</li>{% endfor %}
            </ul>
          {% endif %}

          {% render 'auth-field', type: 'password', name: 'customer[password]', label: 'Nova palavra-passe', autocomplete: 'new-password', required: true %}
          {% render 'auth-field', type: 'password', name: 'customer[password_confirmation]', label: 'Confirmar palavra-passe', autocomplete: 'new-password', required: true %}

          <button type="submit" class="btn btn--primary auth__submit">Guardar</button>
        {% endform %}
      </section>
    </div>

    {% render 'auth-aside' %}
  </div>
</div>
