<div class="wrap" style="max-width:520px;padding-top:64px;padding-bottom:88px">
  <h1 class="serif" style="font-size:38px;margin:0 0 28px">Repor palavra-passe</h1>
  {% form 'reset_customer_password' %}
  <label style="display:block;margin-bottom:16px"><span class="opt-label">Nova palavra-passe</span><input type="password" name="customer[password]" style="width:100%;border:1.5px solid #E0DACB;border-radius:12px;padding:13px 18px;font-family:var(--sans);font-size:15px;background:#fff;outline:none"></label>
  <label style="display:block;margin-bottom:16px"><span class="opt-label">Confirmar palavra-passe</span><input type="password" name="customer[password_confirmation]" style="width:100%;border:1.5px solid #E0DACB;border-radius:12px;padding:13px 18px;font-family:var(--sans);font-size:15px;background:#fff;outline:none"></label>
  <button type="submit" class="btn btn--primary" style="width:100%">Guardar</button>
{% endform %}
</div>