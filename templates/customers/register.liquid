<div class="auth">
  <div class="auth__card">
    <div class="auth__form">
      <section class="auth__pane">
        <h1 class="serif auth__title">Criar conta</h1>
        <p class="auth__sub">Demora um minuto e fica com o histórico de encomendas sempre à mão.</p>

        {% form 'create_customer' %}
          {% if form.errors %}
            <ul class="auth-notice auth-notice--error">
              {% for field in form.errors %}<li>{{ form.errors.messages[field] }}</li>{% endfor %}
            </ul>
          {% endif %}

          <div class="auth-row">
            {% render 'auth-field', name: 'customer[first_name]', label: 'Nome', autocomplete: 'given-name', required: true %}
            {% render 'auth-field', name: 'customer[last_name]', label: 'Apelido', autocomplete: 'family-name', required: true %}
          </div>

          {% render 'auth-field', type: 'email', name: 'customer[email]', label: 'Email', autocomplete: 'email', required: true %}
          {% render 'auth-field', type: 'password', name: 'customer[password]', label: 'Palavra-passe', autocomplete: 'new-password', required: true %}

          <button type="submit" class="btn btn--primary auth__submit">Criar conta</button>
        {% endform %}

        <p class="auth__alt">Já tem conta? <a href="{{ routes.account_login_url }}">Iniciar sessão</a></p>
      </section>
    </div>

    {% render 'auth-aside' %}
  </div>
</div>
