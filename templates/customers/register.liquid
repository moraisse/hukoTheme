<div class="wrap" style="max-width:520px;padding-top:32px;padding-bottom:88px">
  <h1 class="serif" style="font-size:38px;margin:0 0 28px">Criar conta</h1>
  {% form 'create_customer' %}
  <label style="display:block;margin-bottom:16px"><span class="opt-label">Nome</span><input type="text" name="customer[first_name]" style="width:100%;border:1.5px solid #E0DACB;border-radius:12px;padding:13px 18px;font-family:var(--sans);font-size:15px;background:#fff;outline:none"></label>
  <label style="display:block;margin-bottom:16px"><span class="opt-label">Apelido</span><input type="text" name="customer[last_name]" style="width:100%;border:1.5px solid #E0DACB;border-radius:12px;padding:13px 18px;font-family:var(--sans);font-size:15px;background:#fff;outline:none"></label>
  <label style="display:block;margin-bottom:16px"><span class="opt-label">Email</span><input type="email" name="customer[email]" style="width:100%;border:1.5px solid #E0DACB;border-radius:12px;padding:13px 18px;font-family:var(--sans);font-size:15px;background:#fff;outline:none"></label>
  <label style="display:block;margin-bottom:16px"><span class="opt-label">Palavra-passe</span><input type="password" name="customer[password]" style="width:100%;border:1.5px solid #E0DACB;border-radius:12px;padding:13px 18px;font-family:var(--sans);font-size:15px;background:#fff;outline:none"></label>
  <button type="submit" class="btn btn--primary" style="width:100%">Criar conta</button>
{% endform %}
</div>