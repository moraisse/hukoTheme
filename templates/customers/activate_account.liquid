<div class="auth">
  <div class="auth__card">
    <div class="auth__form">
      <section class="auth__pane">
        <h1 class="serif auth__title">Ativar conta</h1>
        <p class="auth__sub">Defina uma palavra-passe para terminar a criação da sua conta.</p>

        {% form 'activate_customer_password' %}
          {% if form.errors %}
            <ul class="auth-notice auth-notice--error">
              {% for field in form.errors %}<li>{{ form.errors.messages[field] }}</li>{% endfor %}
            </ul>
          {% endif %}

          {% render 'auth-field', type: 'password', name: 'customer[password]', label: 'Palavra-passe', autocomplete: 'new-password', required: true %}
          {% render 'auth-field', type: 'password', name: 'customer[password_confirmation]', label: 'Confirmar palavra-passe', autocomplete: 'new-password', required: true %}

          <button type="submit" class="btn btn--primary auth__submit">Ativar conta</button>
          <p class="auth__alt"><button type="submit" name="decline" class="auth__link auth__link--button">Recusar convite</button></p>
        {% endform %}
      </section>
    </div>

    {% render 'auth-aside' %}
  </div>
</div>
