{%- comment -%}
  Página hub do Espaço HUKO (/pages/espaco-huko).
  Os artigos vêm do blog "noticias"; o texto antigo guardado na página não é usado
  por este modelo (fica intacto no admin). O trilho e a newsletter vêm do layout.
{%- endcomment -%}
{{ 'espaco-huko.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign hub_blog = blogs['noticias']
  assign lead = hub_blog.articles.first
  assign product_handles = 'natura-diet-grain-free-duck-sweet-potato-3-kg,burbur-aura-champo-royal-silk,transportadora-mochila-k2-pro,agui-essence-bed,moments-dog-fruit-60-g-cx-12-un,arranhador-basic,natura-diet-fish-rice,natura-diet-grain-free-salmon-coconut' | split: ','
-%}
<div class="eh">
  <section class="eh-hero">
    <div class="wrap">
      <div class="eh-hero__grid">
        <div class="eh-hero__copy">
          <p class="eh-kicker">Conhecimento para uma vida mais feliz</p>
          <h1 class="eh-hero__title">{{ page.title }}<span>guias para cães e gatos</span></h1>
          <p class="eh-hero__lead">Dicas, guias e inspiração para quem cuida do seu animal com carinho. Ajudamos a escolher melhor alimentação, conforto, higiene, grooming e acessórios, sempre com ligação a produtos reais disponíveis na HUKO pets.</p>
          <form action="{{ routes.search_url }}" method="get" role="search" class="eh-search">
            <input type="hidden" name="type" value="article">
            <input type="hidden" name="options[prefix]" value="last">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m20 20-4.8-4.8"/></svg>
            <label for="EhHubSearch" class="visually-hidden">Pesquisar artigos</label>
            <input id="EhHubSearch" type="search" name="q" placeholder="Pesquisar artigos e guias" autocomplete="off">
            <button type="submit">Pesquisar</button>
          </form>
          <ul class="eh-chips" aria-label="Temas">
            <li><a class="eh-chip" href="/collections/caes">Cães</a></li>
            <li><a class="eh-chip" href="/collections/gatos">Gatos</a></li>
            <li><a class="eh-chip" href="/collections/grooming">Grooming Pro</a></li>
            <li><a class="eh-chip" href="/collections/caes-alimentacao">Alimentação</a></li>
            <li><a class="eh-chip" href="/collections/caes-saude-e-higiene">Higiene</a></li>
            <li><a class="eh-chip" href="/collections/caes-acessorios-e-conforto">Bem-estar</a></li>
            <li><a class="eh-chip" href="/collections/caes-acessorios-e-conforto-transportadoras-e-viagem">Viagem</a></li>
          </ul>
        </div>
        {%- if lead != blank -%}
          <div class="eh-hero__feature">
            <span class="eh-hero__badge">★ Em destaque</span>
            {% render 'eh-article-card', article: lead, heading: 'h2', excerpt: true, eager: true %}
          </div>
        {%- endif -%}
      </div>
    </div>
  </section>

  {%- if hub_blog.articles_count > 1 -%}
    <section class="eh-section" id="artigos">
      <div class="wrap">
        <div class="eh-head">
          <div>
            <p class="eh-kicker">Aprender para escolher melhor</p>
            <h2 class="eh-h2">Últimos artigos</h2>
          </div>
          <a class="eh-more" href="{{ hub_blog.url }}">Ver todos os artigos →</a>
        </div>
        <ul class="eh-grid">
          {%- for article in hub_blog.articles offset: 1 limit: 6 -%}
            <li>{% render 'eh-article-card', article: article, heading: 'h3', excerpt: true %}</li>
          {%- endfor -%}
        </ul>
      </div>
    </section>
  {%- endif -%}

  <section class="eh-section eh-section--white">
    <div class="wrap">
      <div class="eh-head">
        <div>
          <p class="eh-kicker">Explorar por tema</p>
          <h2 class="eh-h2">Guias rápidos para cada necessidade</h2>
        </div>
      </div>
      <ul class="eh-topicgrid">
        <li><a class="eh-topic" href="/collections/caes-alimentacao"><span class="eh-topic__icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11h18a9 9 0 0 1-18 0Z"/><path d="M8 7c0-1.5 1-2 1-3.5M12 7c0-1.5 1-2 1-3.5M16 7c0-1.5 1-2 1-3.5"/></svg></span><span class="eh-topic__title">Alimentação</span><span class="eh-topic__text">Como escolher a ração e os snacks certos</span><span class="eh-topic__go" aria-hidden="true">→</span></a></li>
        <li><a class="eh-topic" href="/collections/caes-saude-e-higiene"><span class="eh-topic__icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3s6 6.5 6 11a6 6 0 0 1-12 0c0-4.5 6-11 6-11Z"/></svg></span><span class="eh-topic__title">Higiene e saúde</span><span class="eh-topic__text">Banho, cosmética e cuidados do dia a dia</span><span class="eh-topic__go" aria-hidden="true">→</span></a></li>
        <li><a class="eh-topic" href="/collections/grooming"><span class="eh-topic__icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="6" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><path d="M20 4 8.1 15.9M14.5 14.5 20 20M8.1 8.1 12 12"/></svg></span><span class="eh-topic__title">Grooming</span><span class="eh-topic__text">Ferramentas e técnicas profissionais</span><span class="eh-topic__go" aria-hidden="true">→</span></a></li>
        <li><a class="eh-topic" href="/collections/caes-acessorios-e-conforto-transportadoras-e-viagem"><span class="eh-topic__icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="7" width="18" height="13" rx="2"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg></span><span class="eh-topic__title">Conforto e viagem</span><span class="eh-topic__text">Camas, transportadoras e passeio</span><span class="eh-topic__go" aria-hidden="true">→</span></a></li>
      </ul>
    </div>
  </section>

  <section class="eh-section">
    <div class="wrap">
      <div class="eh-bridge">
        <div>
          <p class="eh-kicker">Conteúdo ligado à loja</p>
          <h2 class="eh-h2">Do guia à escolha certa</h2>
          <p>No Espaço HUKO, os artigos ajudam a perceber as diferenças entre produtos e categorias e levam diretamente às opções disponíveis na loja.</p>
        </div>
        <div class="eh-bridge__links">
          <a href="/collections/caes-alimentacao-racao-seca">Ração seca <span aria-hidden="true">→</span></a>
          <a href="/collections/grooming-higiene-e-cosmetica-champos-e-condicionadores">Champôs <span aria-hidden="true">→</span></a>
          <a href="/collections/caes-acessorios-e-conforto-camas-almofadas-e-tapetes">Camas <span aria-hidden="true">→</span></a>
          <a href="/collections/caes-acessorios-e-conforto-transportadoras-e-viagem">Viagem <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="eh-section eh-section--white">
    <div class="wrap">
      <div class="eh-head">
        <div>
          <p class="eh-kicker">Seleção HUKO</p>
          <h2 class="eh-h2">Produtos recomendados nos conteúdos</h2>
        </div>
      </div>
      <div class="prod-grid">
        {%- assign shown = 0 -%}
        {%- for h in product_handles -%}
          {%- assign p = all_products[h] -%}
          {%- if p.id == blank or shown >= 8 -%}{%- continue -%}{%- endif -%}
          {%- assign shown = shown | plus: 1 -%}
          {% render 'product-card', card_product: p, white: true %}
        {%- endfor -%}
      </div>
    </div>
  </section>
</div>

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": {{ page.title | json }},
    "url": {{ shop.url | append: page.url | json }},
    "description": "Guias e conselhos da HUKO pets sobre alimentação, higiene, grooming, conforto e viagem para cães e gatos.",
    "inLanguage": "pt-PT",
    "isPartOf": { "@type": "WebSite", "name": "HUKO pets", "url": "https://hukopets.com/" },
    "mainEntity": {
      "@type": "ItemList",
      "itemListElement": [
        {%- for article in hub_blog.articles limit: 10 -%}
          { "@type": "ListItem", "position": {{ forloop.index }}, "url": {{ shop.url | append: article.url | json }}, "name": {{ article.title | json }} }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  }
</script>
