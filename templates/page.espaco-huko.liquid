{%- comment -%}
  Página hub do Espaço HUKO (/pages/espaco-huko).
  Os artigos vêm do blog "noticias"; o texto antigo guardado na página não é usado
  por este modelo (fica intacto no admin). O trilho e a newsletter vêm do layout.
{%- endcomment -%}
{{ 'espaco-huko.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign hub_blog = blogs['noticias']

  comment
    Cada artigo vai para uma de três áreas, pelas tags:
    - Novidades da loja: anúncios e lançamentos (tag "Novidades");
    - Área profissional: equipamento e grooming profissional;
    - Dicas e guias: todos os restantes.
    Novidades da loja e Dicas e guias ficam juntas no separador "Para tutores", cada
    uma com os seus cartões. O destaque do topo é a novidade mais recente (que também
    aparece nas Novidades); sem novidades, é o guia mais recente.
  endcomment
  assign news_tags = 'Novidades,Lançamentos' | split: ','
  assign pro_tags = 'Área profissional,Grooming profissional,Grooming,Secadores e expulsores' | split: ','
  assign news_ids = ','
  assign pro_ids = ','
  assign guide_ids = ','
  assign lead = nil
  assign first_news = nil
  assign first_guide = nil
  for a in hub_blog.articles
    assign kind = 'guide'
    for t in a.tags
      if news_tags contains t
        assign kind = 'news'
        break
      elsif pro_tags contains t
        assign kind = 'pro'
      endif
    endfor
    case kind
      when 'news'
        assign news_ids = news_ids | append: a.id | append: ','
        if first_news == nil
          assign first_news = a
        endif
      when 'pro'
        assign pro_ids = pro_ids | append: a.id | append: ','
      else
        assign guide_ids = guide_ids | append: a.id | append: ','
        if first_guide == nil
          assign first_guide = a
        endif
    endcase
  endfor
  if first_news != nil
    assign lead = first_news
  elsif first_guide != nil
    assign lead = first_guide
    assign needle = ',' | append: lead.id | append: ','
    assign guide_ids = guide_ids | replace: needle, ','
  else
    assign lead = hub_blog.articles.first
  endif
  assign has_tutor = false
  if news_ids != ',' or guide_ids != ','
    assign has_tutor = true
  endif
  assign product_handles = 'natura-diet-grain-free-duck-sweet-potato-3-kg,burbur-aura-champo-royal-silk,transportadora-mochila-k2-pro,agui-essence-bed,moments-dog-fruit-60-g-cx-12-un,arranhador-basic,natura-diet-fish-rice,natura-diet-grain-free-salmon-coconut' | split: ','
-%}
<div class="eh">
  <section class="eh-hero">
    <div class="wrap">
      <div class="eh-hero__grid">
        <div class="eh-hero__copy">
          <p class="eh-kicker">Conhecimento para uma vida mais feliz</p>
          <h1 class="eh-hero__title">{{ page.title }}</h1>
          <p class="eh-hero__lead">Dicas, guias e inspiração para quem cuida do seu animal com carinho. Ajudamos a escolher melhor alimentação, conforto, higiene, grooming e acessórios, sempre com ligação a produtos reais disponíveis na HUKO pets.</p>
        </div>
        {%- if lead != blank -%}
          <div class="eh-hero__feature">
            <span class="eh-hero__badge">★ Em destaque</span>
            {% render 'eh-article-card', article: lead, heading: 'h2', excerpt: true, eager: true %}
          </div>
        {%- endif -%}
      </div>
    </div>
  </section>

  {%- if has_tutor or pro_ids != ',' -%}
    <section class="eh-section" id="artigos" data-eh-tabs>
      <div class="wrap">
        {%- if has_tutor and pro_ids != ',' -%}
          <div class="eh-head eh-head--tabs">
            <div class="eh-seg" role="group" aria-label="Escolher tipo de artigo">
              <button type="button" aria-pressed="true" data-eh-tab="tutores" aria-controls="para-tutores">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v15H6.5A2.5 2.5 0 0 0 4 20.5z"/><path d="M4 20.5A2.5 2.5 0 0 0 6.5 23H20v-5"/></svg>
                Para tutores
              </button>
              <button type="button" aria-pressed="false" data-eh-tab="profissional" aria-controls="area-profissional">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="6" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><path d="M20 4 8.1 15.9M14.5 14.5 20 20M8.1 8.1 12 12"/></svg>
                Área profissional
              </button>
            </div>
          </div>
        {%- endif -%}

        {%- if has_tutor -%}
          <div class="eh-panel" id="para-tutores" data-eh-panel="tutores">
            {%- if news_ids != ',' -%}
              <div class="eh-cat eh-news__panel" id="novidades">
                <div class="eh-cat__head">
                  <div>
                    <p class="eh-kicker">Novidades da loja</p>
                    <h2 class="eh-cat__title">Lançamentos e anúncios HUKO</h2>
                  </div>
                  <a class="eh-more" href="{{ hub_blog.url }}/tagged/novidades">Ver todas as novidades →</a>
                </div>
                <ul class="eh-news__list">
                  {%- assign shown = 0 -%}
                  {%- for article in hub_blog.articles -%}
                    {%- assign needle = ',' | append: article.id | append: ',' -%}
                    {%- unless news_ids contains needle and shown < 4 -%}{%- continue -%}{%- endunless -%}
                    {%- assign shown = shown | plus: 1 -%}
                    <li class="eh-news__item">
                      <span class="eh-news__badge">Novidade</span>
                      {% render 'eh-article-card', article: article, layout: 'featured', heading: 'h3', excerpt: true %}
                    </li>
                  {%- endfor -%}
                </ul>
              </div>
            {%- endif -%}

            {%- if guide_ids != ',' -%}
              <div class="eh-cat" id="dicas-e-guias">
                <div class="eh-cat__head">
                  <div>
                    <p class="eh-kicker">Dicas e guias</p>
                    <h2 class="eh-cat__title">Guias para cuidar melhor do seu animal</h2>
                  </div>
                  <a class="eh-more" href="{{ hub_blog.url }}">Ver todos os artigos →</a>
                </div>
                <ul class="eh-grid">
                  {%- assign shown = 0 -%}
                  {%- for article in hub_blog.articles -%}
                    {%- assign needle = ',' | append: article.id | append: ',' -%}
                    {%- unless guide_ids contains needle and shown < 12 -%}{%- continue -%}{%- endunless -%}
                    {%- assign shown = shown | plus: 1 -%}
                    <li>{% render 'eh-article-card', article: article, heading: 'h3', excerpt: true %}</li>
                  {%- endfor -%}
                </ul>
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if pro_ids != ',' -%}
          <div class="eh-panel eh-pro" id="area-profissional" data-eh-panel="profissional">
            <div class="eh-pro__head">
              <div>
                <p class="eh-kicker"><span class="eh-pro__badge">Pro</span>Área profissional</p>
                <h2 class="eh-pro__title">Guias para grooming profissional</h2>
                <p class="eh-pro__text">Equipamento, secagem e técnicas para salões de grooming e para quem trabalha com cães todos os dias.</p>
              </div>
              <a class="eh-pro__cta" href="/collections/grooming">Ver equipamento Grooming Pro <span aria-hidden="true">→</span></a>
            </div>
            <ul class="eh-grid">
              {%- assign shown = 0 -%}
              {%- for article in hub_blog.articles -%}
                {%- assign needle = ',' | append: article.id | append: ',' -%}
                {%- unless pro_ids contains needle and shown < 12 -%}{%- continue -%}{%- endunless -%}
                {%- assign shown = shown | plus: 1 -%}
                <li>{% render 'eh-article-card', article: article, heading: 'h3', excerpt: true %}</li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      </div>
    </section>
    <script>
      (function () {
        var root = document.querySelector('[data-eh-tabs]');
        if (!root) return;
        var buttons = root.querySelectorAll('[data-eh-tab]');
        if (!buttons.length) return;
        var panels = root.querySelectorAll('[data-eh-panel]');
        var show = function (key) {
          buttons.forEach(function (b) { b.setAttribute('aria-pressed', b.getAttribute('data-eh-tab') === key ? 'true' : 'false'); });
          panels.forEach(function (p) { p.hidden = p.getAttribute('data-eh-panel') !== key; });
        };
        buttons.forEach(function (b) { b.addEventListener('click', function () { show(b.getAttribute('data-eh-tab')); }); });
        show(location.hash === '#area-profissional' ? 'profissional' : 'tutores');
      })();
    </script>
  {%- endif -%}

  <section class="eh-section eh-section--white">
    <div class="wrap">
      <div class="eh-head">
        <div>
          <p class="eh-kicker">Explorar por tema</p>
          <h2 class="eh-h2">Guias rápidos para cada necessidade</h2>
        </div>
      </div>
      <ul class="eh-topicgrid">
        <li><a class="eh-topic" href="/collections/caes-alimentacao"><span class="eh-topic__icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11h18a9 9 0 0 1-18 0Z"/><path d="M8 7c0-1.5 1-2 1-3.5M12 7c0-1.5 1-2 1-3.5M16 7c0-1.5 1-2 1-3.5"/></svg></span><span class="eh-topic__title">Alimentação</span><span class="eh-topic__text">Como escolher a ração e os snacks certos</span><span class="eh-topic__go" aria-hidden="true">→</span></a></li>
        <li><a class="eh-topic" href="/collections/caes-saude-e-higiene"><span class="eh-topic__icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3s6 6.5 6 11a6 6 0 0 1-12 0c0-4.5 6-11 6-11Z"/></svg></span><span class="eh-topic__title">Higiene e saúde</span><span class="eh-topic__text">Banho, cosmética e cuidados do dia a dia</span><span class="eh-topic__go" aria-hidden="true">→</span></a></li>
        <li><a class="eh-topic" href="/collections/grooming"><span class="eh-topic__icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="6" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><path d="M20 4 8.1 15.9M14.5 14.5 20 20M8.1 8.1 12 12"/></svg></span><span class="eh-topic__title">Grooming</span><span class="eh-topic__text">Ferramentas e técnicas profissionais</span><span class="eh-topic__go" aria-hidden="true">→</span></a></li>
        <li><a class="eh-topic" href="/collections/caes-acessorios-e-conforto-transportadoras-e-viagem"><span class="eh-topic__icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="7" width="18" height="13" rx="2"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg></span><span class="eh-topic__title">Conforto e viagem</span><span class="eh-topic__text">Camas, transportadoras e passeio</span><span class="eh-topic__go" aria-hidden="true">→</span></a></li>
      </ul>
    </div>
  </section>

  <section class="eh-section">
    <div class="wrap">
      <div class="eh-bridge">
        <div>
          <p class="eh-kicker">Conteúdo ligado à loja</p>
          <h2 class="eh-h2">Do guia à escolha certa</h2>
          <p>No Espaço HUKO, os artigos ajudam a perceber as diferenças entre produtos e categorias e levam diretamente às opções disponíveis na loja.</p>
        </div>
        <div class="eh-bridge__links">
          <a href="/collections/caes-alimentacao-racao-seca">Ração seca <span aria-hidden="true">→</span></a>
          <a href="/collections/grooming-higiene-e-cosmetica-champos-e-condicionadores">Champôs <span aria-hidden="true">→</span></a>
          <a href="/collections/caes-acessorios-e-conforto-camas-almofadas-e-tapetes">Camas <span aria-hidden="true">→</span></a>
          <a href="/collections/caes-acessorios-e-conforto-transportadoras-e-viagem">Viagem <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="eh-section eh-section--white">
    <div class="wrap">
      <div class="eh-head">
        <div>
          <p class="eh-kicker">Seleção HUKO</p>
          <h2 class="eh-h2">Produtos recomendados nos conteúdos</h2>
        </div>
      </div>
      <div class="prod-grid">
        {%- assign shown = 0 -%}
        {%- for h in product_handles -%}
          {%- assign p = all_products[h] -%}
          {%- if p.id == blank or shown >= 8 -%}{%- continue -%}{%- endif -%}
          {%- assign shown = shown | plus: 1 -%}
          {% render 'product-card', card_product: p, white: true %}
        {%- endfor -%}
      </div>
    </div>
  </section>
</div>

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": {{ page.title | json }},
    "url": {{ shop.url | append: page.url | json }},
    "description": "Guias e conselhos da HUKO pets sobre alimentação, higiene, grooming, conforto e viagem para cães e gatos.",
    "inLanguage": "pt-PT",
    "isPartOf": { "@type": "WebSite", "name": "HUKO pets", "url": "https://hukopets.com/" },
    "mainEntity": {
      "@type": "ItemList",
      "itemListElement": [
        {%- for article in hub_blog.articles limit: 10 -%}
          { "@type": "ListItem", "position": {{ forloop.index }}, "url": {{ shop.url | append: article.url | json }}, "name": {{ article.title | json }} }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  }
</script>
