{%- assign sort = collection.sort_by | default: collection.default_sort_by -%}
{%- capture grooming_context -%}{%- render 'grooming-context', current_collection: collection -%}{%- endcapture -%}
{%- assign grooming_context = grooming_context | strip -%}
{%- assign is_grooming = false -%}
{%- if grooming_context == 'true' -%}{%- assign is_grooming = true -%}{%- endif -%}
{%- assign grooming_handle_prefix = collection.handle | slice: 0, 9 -%}
{%- if collection.handle == 'grooming' or grooming_handle_prefix == 'grooming-' -%}{%- assign is_grooming = true -%}{%- endif -%}
{%- assign grooming_root = linklists.main-menu.links | where: 'handle', 'grooming' | first -%}
{%- capture grooming_destination -%}{%- render 'grooming-url' -%}{%- endcapture -%}
{%- assign has_facets = false -%}
{%- if collection.filters.size > 0 -%}{%- assign has_facets = true -%}{%- endif -%}

<div class="wrap">
  <div class="coll-head">
    {% if is_grooming %}
      <div class="grooming-heading__eyebrow">{{ 'general.grooming.professional' | t }} <span class="nav-grooming__badge">{{ 'general.navigation.pro' | t }}</span></div>
    {% endif %}
    <h1>{{ collection.title }}</h1>
    {% if collection.description != blank %}<p>{{ collection.description | strip_html }}</p>{% endif %}
    {% if is_grooming %}
      {% if collection.description == blank %}<p>{{ 'general.grooming.intro' | t }}</p>{% endif %}
      <div class="grooming-heading__meta">
        <span>{{ 'general.grooming.product_count' | t: count: collection.products_count }}</span>
        <a href="https://wa.me/351931198604" class="grooming-whatsapp" target="_blank" rel="noopener noreferrer"><svg class="footer-icon footer-icon--whatsapp" width="14" height="14" viewBox="0 0 32 32" fill="#fff" aria-hidden="true"><path d="M16 0C7.163 0 0 7.163 0 16c0 2.837.744 5.5 2.05 7.813L0 32l8.417-2.02A15.93 15.93 0 0 0 16 32c8.837 0 16-7.163 16-16S24.837 0 16 0zm0 29.09c-2.55 0-4.95-.68-7.02-1.87l-.5-.3-5 1.2 1.23-4.87-.33-.5A13.06 13.06 0 0 1 2.91 16C2.91 8.77 8.77 2.91 16 2.91S29.09 8.77 29.09 16 23.23 29.09 16 29.09zm7.13-9.78c-.39-.2-2.3-1.13-2.66-1.26-.36-.13-.62-.2-.88.2-.26.39-1 1.26-1.23 1.52-.23.26-.45.29-.84.1-.39-.2-1.63-.6-3.1-1.9-1.15-1.02-1.92-2.28-2.15-2.67-.23-.39-.02-.6.17-.8.17-.17.39-.45.58-.68.2-.23.26-.39.39-.65.13-.26.06-.49-.03-.68-.1-.2-.88-2.13-1.2-2.92-.32-.77-.65-.66-.88-.67h-.75c-.26 0-.68.1-1.04.49-.36.39-1.36 1.33-1.36 3.24s1.39 3.76 1.58 4.02c.2.26 2.73 4.17 6.62 5.85.93.4 1.65.64 2.22.82.93.3 1.78.26 2.45.16.75-.11 2.3-.94 2.62-1.85.32-.9.32-1.68.23-1.85-.1-.16-.36-.26-.75-.46z"/></svg>{{ 'general.grooming.support' | t }}</a>
      </div>
    {% endif %}
  </div>

  {% if is_grooming and grooming_root.links.size > 0 %}
    <nav class="grooming-categories" aria-label="{{ 'general.grooming.categories' | t | escape }}">
      <a href="{{ grooming_destination }}"{% if collection.url == grooming_destination %} aria-current="page"{% endif %}>{{ 'general.grooming.all' | t }}</a>
      {% for child in grooming_root.links %}
        <a href="{{ child.url }}"{% if collection.url == child.url %} aria-current="page"{% endif %}>{{ child.title }}</a>
      {% endfor %}
    </nav>
  {% endif %}

  <div class="toolbar">
    {% if has_facets %}
      <button type="button" class="facets-toggle" data-facets-toggle aria-expanded="false" aria-controls="FacetsSidebar">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><line x1="3" y1="7" x2="21" y2="7"/><line x1="6" y1="12" x2="18" y2="12"/><line x1="9" y1="17" x2="15" y2="17"/></svg>
        Filtros
      </button>
    {% endif %}

    {% render 'sort-by', sort_value: sort, has_facets: has_facets %}
  </div>

  <div class="results-layout{% unless has_facets %} results-layout--full{% endunless %}">
    {% if has_facets %}
      <aside class="results-side" id="FacetsSidebar">
        {% render 'facets', filters: collection.filters, sort_value: sort, clear_url: collection.url, has_sort_control: true %}
      </aside>
    {% endif %}

    <div class="results-main">
      {% paginate collection.products by 12 %}
        <div class="prod-grid" style="padding-bottom:24px">
          {% for product in collection.products %}{% render 'product-card', card_product: product, white: true %}{% endfor %}
        </div>
        {% render 'pagination', paginate: paginate %}
      {% endpaginate %}
    </div>
  </div>

  <div style="padding-bottom:72px"></div>
</div>
