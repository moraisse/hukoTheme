{%- assign s = section.settings -%}
<section class="essentials section slot-dark" data-screen-label="Coleção Essentials">
  <div class="wrap ess-grid">
    <div class="ess-copy">
      {%- if s.eyebrow != blank -%}<span class="eyebrow gold">{{ s.eyebrow }}</span>{%- endif -%}
      <h2>{{ s.heading }} {% if s.heading_accent != blank %}<em>{{ s.heading_accent }}</em>{% endif %}</h2>
      {%- if s.text != blank -%}<p>{{ s.text }}</p>{%- endif -%}
      {%- if section.blocks.size > 0 -%}
        <ul class="ess-list">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}><span class="dot"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M20 7 9 18l-5-5"/></svg></span> {{ block.settings.text }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
      {%- if s.button_label != blank -%}<a href="{{ s.button_link }}" class="btn btn-cream">{{ s.button_label }}</a>{%- endif -%}
    </div>
    <div class="ess-media">
      <div class="r-media on-dark" style="aspect-ratio:1/1.02;border-radius:var(--radius-lg)" data-ph="coleção essentials">
        {%- if s.image != blank -%}<img src="{{ s.image | image_url: width: 1100 }}" alt="{{ s.image.alt | escape }}" loading="lazy">{%- endif -%}
      </div>
      <div class="ess-frame"></div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Coleção em destaque",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sobre-título", "default": "Coleção em destaque" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Coleção" },
    { "type": "text", "id": "heading_accent", "label": "Palavra em destaque (itálico dourado)", "default": "Essentials" },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "Os indispensáveis para uma rotina mais bonita, prática e confortável." },
    { "type": "image_picker", "id": "image", "label": "Imagem" },
    { "type": "text", "id": "button_label", "label": "Botão", "default": "Explorar coleção" },
    { "type": "url", "id": "button_link", "label": "Link do botão" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Característica",
      "settings": [ { "type": "text", "id": "text", "label": "Texto", "default": "Materiais naturais e ferragens em latão" } ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "Coleção em destaque",
      "blocks": [
        { "type": "feature", "settings": { "text": "Coleira, trela e taça em tons coordenados" } },
        { "type": "feature", "settings": { "text": "Materiais naturais e ferragens em latão" } },
        { "type": "feature", "settings": { "text": "Edição limitada · embalagem reutilizável" } }
      ]
    }
  ]
}
{% endschema %}
