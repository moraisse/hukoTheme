<section class="reviews section" data-screen-label="Avaliações">
  <div class="wrap">
    <div class="sec-head" style="justify-content:center;text-align:center;flex-direction:column;align-items:center;margin-bottom:8px">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
    </div>
    <div class="rev-grid">
      {%- for block in section.blocks -%}
        <article class="rev-card" {{ block.shopify_attributes }}>
          <div class="stars">{% for i in (1..block.settings.rating) %}★{% endfor %}</div>
          <blockquote>“{{ block.settings.quote }}”</blockquote>
          <div class="rev-author">
            <div class="r-media" style="width:46px;height:46px;border-radius:50%" data-ph="foto">
              {%- if block.settings.avatar != blank -%}<img src="{{ block.settings.avatar | image_url: width: 120 }}" alt="{{ block.settings.name | escape }}">{%- endif -%}
            </div>
            <div><b>{{ block.settings.name }}</b><span>{{ block.settings.meta }}</span></div>
          </div>
          {%- if block.settings.verified -%}<div class="rev-verified"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M20 7 9 18l-5-5"/></svg> Compra verificada</div>{%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Avaliações",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sobre-título", "default": "Histórias reais" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Amado por pets e por quem cuida deles" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Avaliação",
      "settings": [
        { "type": "range", "id": "rating", "min": 1, "max": 5, "step": 1, "label": "Estrelas", "default": 5 },
        { "type": "textarea", "id": "quote", "label": "Citação", "default": "Produtos lindos, resistentes e com uma qualidade muito acima do habitual." },
        { "type": "image_picker", "id": "avatar", "label": "Foto" },
        { "type": "text", "id": "name", "label": "Nome", "default": "Marta & Milo" },
        { "type": "text", "id": "meta", "label": "Detalhe", "default": "Lisboa · Golden Retriever" },
        { "type": "checkbox", "id": "verified", "label": "Compra verificada", "default": true }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Avaliações",
      "blocks": [
        { "type": "review", "settings": { "quote": "Produtos lindos, resistentes e com uma qualidade muito acima do habitual. A coleira parece feita à mão.", "name": "Marta & Milo", "meta": "Lisboa · Golden Retriever" } },
        { "type": "review", "settings": { "quote": "A cama é simplesmente linda em casa e a Luna adora. Não destoa da decoração — pelo contrário.", "name": "Tomás & Luna", "meta": "Porto · Gato Europeu" } },
        { "type": "review", "settings": { "quote": "Envio rapidíssimo e embalagem impecável. Nota-se o cuidado em cada detalhe. Já voltei a comprar.", "name": "Inês & Bóris", "meta": "Braga · Border Collie" } }
      ]
    }
  ]
}
{% endschema %}
