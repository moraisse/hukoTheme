{%- liquid
  assign logo = settings.logo
  assign menu = linklists[section.settings.menu]
-%}

{%- if section.settings.show_announcement and section.settings.announcement != blank -%}
  <div class="topbar">{{ section.settings.announcement }}</div>
{%- endif -%}

<header class="header" id="siteHeader" data-screen-label="Header">
  <div class="wrap header-inner">
    <a href="{{ routes.root_url }}" class="logo" aria-label="{{ shop.name | escape }}">
      {%- if logo != blank -%}
        <img src="{{ logo | image_url: width: 480 }}" alt="{{ shop.name | escape }}"
             style="height:{{ settings.logo_height | default: 38 }}px;width:auto"
             width="{{ logo.width }}" height="{{ logo.height }}">
      {%- else -%}
        <img src="{{ 'logo-huko.png' | asset_url }}" alt="{{ shop.name | escape }}"
             style="height:{{ settings.logo_height | default: 38 }}px;width:auto">
      {%- endif -%}
    </a>

    <div class="header-actions">
      <a class="iconbtn" href="{{ routes.search_url }}" aria-label="Pesquisar">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.2-3.2"/></svg>
      </a>
      <a class="iconbtn" href="{{ routes.account_url }}" aria-label="Conta">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="12" cy="8" r="4"/><path d="M5 21c0-3.9 3.1-7 7-7s7 3.1 7 7"/></svg>
      </a>
      <button class="iconbtn" aria-label="Carrinho" data-open="cart" type="button">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M6 8h12l-1.2 11.2a1.5 1.5 0 0 1-1.5 1.3H8.7a1.5 1.5 0 0 1-1.5-1.3L6 8Z"/><path d="M9 8V6.5a3 3 0 0 1 6 0V8"/></svg>
        <span class="cart-count" data-cart-count{% if cart.item_count == 0 %} style="display:none"{% endif %}>{{ cart.item_count }}</span>
      </button>
      <button class="iconbtn burger" aria-label="Menu" data-open="mmenu" type="button">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </div>
</header>

{%- comment -%} Mobile menu {%- endcomment -%}
<div class="scrim" id="mmenu-scrim"></div>
<aside class="mmenu" id="mmenu" data-scrim="mmenu-scrim">
  <div class="mmenu-head">
    <a href="{{ routes.root_url }}" class="logo">
      <img src="{% if logo != blank %}{{ logo | image_url: width: 360 }}{% else %}{{ 'logo-huko.png' | asset_url }}{% endif %}" alt="{{ shop.name | escape }}" style="height:34px">
    </a>
    <button class="iconbtn" data-close="mmenu" aria-label="Fechar" type="button"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M6 6l12 12M18 6 6 18"/></svg></button>
  </div>
  <nav>
    {%- for link in menu.links -%}
      <a href="{{ link.url }}" data-close="mmenu">{{ link.title }}</a>
    {%- endfor -%}
  </nav>
  <div class="mmenu-foot">
    <a href="{{ routes.account_url }}" class="link-arrow">Conta</a>
    <a href="{{ routes.search_url }}" class="link-arrow">Pesquisar</a>
  </div>
</aside>

{% schema %}
{
  "name": "Cabeçalho",
  "settings": [
    { "type": "header", "content": "Barra de anúncio" },
    { "type": "checkbox", "id": "show_announcement", "label": "Mostrar barra de anúncio", "default": true },
    { "type": "richtext", "id": "announcement", "label": "Texto", "default": "<p>Envio grátis em encomendas acima de 50 € · Entregas em toda a Europa</p>" },
    { "type": "header", "content": "Navegação" },
    { "type": "link_list", "id": "menu", "label": "Menu principal", "default": "main-menu" }
  ]
}
{% endschema %}
