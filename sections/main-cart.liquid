{%- comment -%} Full cart page — mirrors the drawer styling {%- endcomment -%}
<section class="section" data-screen-label="Carrinho">
  <div class="wrap" style="max-width:860px">
    <div class="sec-head"><div><span class="eyebrow">O teu carrinho</span><h2>Carrinho</h2></div></div>

    {%- if cart.item_count > 0 -%}
      <form action="{{ routes.cart_url }}" method="post" novalidate>
        <div class="drawer-items" style="padding:0">
          {%- for item in cart.items -%}
            <div class="citem" style="grid-template-columns:94px 1fr auto">
              <div class="r-media" style="width:94px;height:108px;border-radius:var(--radius-sm)" data-ph="produto">
                {%- if item.image -%}<img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title | escape }}">{%- endif -%}
              </div>
              <div>
                <h4><a href="{{ item.url }}">{{ item.product.title }}</a></h4>
                {%- unless item.product.has_only_default_variant -%}<div class="opt">{{ item.variant.title }}</div>{%- endunless -%}
                <div class="qty" data-stepper data-line-key="{{ item.key }}">
                  <button type="button" data-step="-"><svg viewBox="0 0 24 24" width="14" fill="none" stroke="currentColor"><path d="M5 12h14"/></svg></button>
                  <span data-qty>{{ item.quantity }}</span>
                  <button type="button" data-step="+"><svg viewBox="0 0 24 24" width="14" fill="none" stroke="currentColor"><path d="M12 5v14M5 12h14"/></svg></button>
                </div>
              </div>
              <div><div class="cprice">{{ item.final_line_price | money }}</div><a class="remove" href="#" data-remove-key="{{ item.key }}">Remover</a></div>
            </div>
          {%- endfor -%}
        </div>
        <div class="drawer-foot" style="border:0;background:none;padding:24px 0 0">
          <div class="row total"><span>Total</span><span>{{ cart.total_price | money }}</span></div>
          <button class="btn btn-primary btn-block btn-lg" type="submit" name="checkout">Finalizar compra</button>
        </div>
      </form>
    {%- else -%}
      <p style="font-family:var(--font-ui);color:var(--muted)">O teu carrinho está vazio. <a href="{{ routes.all_products_collection_url }}" style="border-bottom:1px solid">Começar a comprar</a></p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{ "name": "Carrinho" }
{% endschema %}
