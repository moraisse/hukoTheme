{%- liquid
  assign s = section.settings
  assign is_bleed = false
  if s.layout == 'bleed'
    assign is_bleed = true
  endif
-%}

<section class="hero{% if is_bleed %} v-bleed slot-dark{% endif %}" data-screen-label="Hero">
  {%- comment -%} Split layout {%- endcomment -%}
  <div class="wrap hero-grid">
    <div class="hero-copy">
      {%- if s.eyebrow != blank -%}<span class="eyebrow">{{ s.eyebrow }}</span>{%- endif -%}
      <h1>{{ s.heading }} {% if s.heading_accent != blank %}<em>{{ s.heading_accent }}</em>{% endif %}</h1>
      {%- if s.subheading != blank -%}<p class="hero-sub">{{ s.subheading }}</p>{%- endif -%}
      <div class="hero-cta">
        {%- if s.button_label != blank -%}<a href="{{ s.button_link }}" class="btn btn-primary btn-lg">{{ s.button_label }}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>{%- endif -%}
        {%- if s.button2_label != blank -%}<a href="{{ s.button2_link }}" class="btn btn-outline btn-lg">{{ s.button2_label }}</a>{%- endif -%}
      </div>
      {%- if s.trust1 != blank or s.trust2 != blank -%}
        <div class="hero-trust">
          {%- if s.trust1 != blank -%}<div><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M20 7 9 18l-5-5"/></svg> {{ s.trust1 }}</div>{%- endif -%}
          {%- if s.trust2 != blank -%}<div><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="m12 3 2.5 5.5L20 9l-4 4 1 6-5-3-5 3 1-6-4-4 5.5-.5L12 3Z"/></svg> {{ s.trust2 }}</div>{%- endif -%}
        </div>
      {%- endif -%}
    </div>
    <div class="hero-media">
      <div class="r-media" style="aspect-ratio:4/4.6;border-radius:var(--radius-lg)" data-ph="imagem de lifestyle">
        {%- if s.image != blank -%}<img src="{{ s.image | image_url: width: 1200 }}" alt="{{ s.image.alt | escape }}">{%- endif -%}
      </div>
      {%- if s.badge_text != blank -%}
        <div class="hero-badge"><div><div class="star">★★★★★</div><b>{{ s.badge_text }}</b><span>{{ s.badge_sub }}</span></div></div>
      {%- endif -%}
    </div>
  </div>

  {%- comment -%} Full-bleed layout {%- endcomment -%}
  <div class="hero-bleed">
    <div class="r-media on-dark" style="position:absolute;inset:0;width:100%;height:100%" data-ph="imagem full-bleed">
      {%- if s.image != blank -%}<img src="{{ s.image | image_url: width: 2200 }}" alt="{{ s.image.alt | escape }}">{%- endif -%}
    </div>
    <div class="hero-overlay">
      <div class="wrap">
        <div class="hero-copy">
          {%- if s.eyebrow != blank -%}<span class="eyebrow gold">{{ s.eyebrow }}</span>{%- endif -%}
          <h1>{{ s.heading }} {% if s.heading_accent != blank %}<em>{{ s.heading_accent }}</em>{% endif %}</h1>
          {%- if s.subheading != blank -%}<p class="hero-sub">{{ s.subheading }}</p>{%- endif -%}
          <div class="hero-cta">
            {%- if s.button_label != blank -%}<a href="{{ s.button_link }}" class="btn btn-primary btn-lg">{{ s.button_label }}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>{%- endif -%}
            {%- if s.button2_label != blank -%}<a href="{{ s.button2_link }}" class="btn btn-ghost-light btn-lg">{{ s.button2_label }}</a>{%- endif -%}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "select", "id": "layout", "label": "Disposição", "options": [ { "value": "split", "label": "Dividido (texto + imagem)" }, { "value": "bleed", "label": "Imagem total" } ], "default": "split" },
    { "type": "text", "id": "eyebrow", "label": "Sobre-título", "default": "Acessórios premium · feitos para durar" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Acessórios premium para pets" },
    { "type": "text", "id": "heading_accent", "label": "Título — palavra em destaque (itálico)", "default": "com estilo." },
    { "type": "textarea", "id": "subheading", "label": "Subtítulo", "default": "Produtos selecionados para conforto, design e bem-estar — pensados para animais que fazem parte da família." },
    { "type": "text", "id": "button_label", "label": "Botão principal", "default": "Comprar agora" },
    { "type": "url", "id": "button_link", "label": "Link do botão principal" },
    { "type": "text", "id": "button2_label", "label": "Botão secundário", "default": "Ver coleções" },
    { "type": "url", "id": "button2_link", "label": "Link do botão secundário" },
    { "type": "image_picker", "id": "image", "label": "Imagem" },
    { "type": "header", "content": "Selos de confiança" },
    { "type": "text", "id": "trust1", "label": "Selo 1", "default": "+12.000 famílias felizes" },
    { "type": "text", "id": "trust2", "label": "Selo 2", "default": "4,9 / 5 em avaliações" },
    { "type": "header", "content": "Cartão de avaliação (só disposição dividida)" },
    { "type": "text", "id": "badge_text", "label": "Citação", "default": "Qualidade muito acima do habitual." },
    { "type": "text", "id": "badge_sub", "label": "Autor", "default": "Marta & Milo · cliente verificado" }
  ],
  "presets": [ { "name": "Hero" } ]
}
{% endschema %}
