<section class="wrap editorial" style="padding-bottom:96px">
  <div class="editorial__img">{% if section.settings.image != blank %}<img src="{{ section.settings.image | image_url: width: 1200 }}" alt="{{ section.settings.heading | escape }}">{% endif %}</div>
  <div>
    <div class="eyebrow" style="margin-bottom:20px">{{ section.settings.eyebrow }}</div>
    <h2>{{ section.settings.heading }}</h2>
    <div class="rte" style="max-width:none">{{ section.settings.body }}</div>
    {% if section.settings.button_label != blank %}<a href="{{ section.settings.button_url }}" class="btn btn--ghost" style="margin-top:26px">{{ section.settings.button_label }}</a>{% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Editorial",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto pequeno (eyebrow)", "default": "A nossa filosofia" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Designed for pets. Chosen by people who care." },
    { "type": "richtext", "id": "body", "label": "Texto", "default": "<p>Na HUKO pets acreditamos que os acessórios do teu animal fazem parte da tua casa — e da vossa vida em conjunto. Por isso selecionamos apenas produtos funcionais, bonitos e feitos para durar.</p><p>Menos coisas, melhores coisas. Para animais felizes e donos tranquilos.</p>" },
    { "type": "image_picker", "id": "image", "label": "Imagem" },
    { "type": "text", "id": "button_label", "label": "Texto do botão", "default": "Conhecer a HUKO" },
    { "type": "url", "id": "button_url", "label": "Link do botão" }
  ],
  "presets": [{ "name": "Editorial" }]
}
{% endschema %}
