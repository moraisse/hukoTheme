<section class="section" data-screen-label="Categorias">
  <div class="wrap">
    <div class="sec-head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.intro != blank -%}<p>{{ section.settings.intro }}</p>{%- endif -%}
    </div>

    <div class="cat-grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign col = collections[block.settings.collection]
          assign title = block.settings.title | default: col.title
          assign img = block.settings.image | default: col.image | default: col.featured_image
          assign link = block.settings.link | default: col.url
        -%}
        <a class="cat-card" href="{{ link }}" {{ block.shopify_attributes }}>
          <div class="r-media" style="aspect-ratio:1/1.04" data-ph="{{ title | escape }}">
            {%- if img != blank -%}<img src="{{ img | image_url: width: 700 }}" alt="{{ title | escape }}" loading="lazy">{%- endif -%}
          </div>
          <div class="cat-go"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M7 17 17 7M9 7h8v8"/></svg></div>
          <div class="cat-body">
            <h3>{{ title }}</h3>
            {%- if block.settings.subtitle != blank -%}<span>{{ block.settings.subtitle }}</span>{%- endif -%}
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Categorias",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sobre-título", "default": "Explorar" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Comprar por categoria" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Tudo o que o teu pet precisa, organizado para a rotina real — do passeio matinal ao descanso ao fim do dia." }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Categoria",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Coleção" },
        { "type": "text", "id": "title", "label": "Título (opcional)" },
        { "type": "text", "id": "subtitle", "label": "Microcopy" },
        { "type": "image_picker", "id": "image", "label": "Imagem (opcional)" },
        { "type": "url", "id": "link", "label": "Link (opcional)" }
      ]
    }
  ],
  "max_blocks": 9,
  "presets": [
    {
      "name": "Categorias",
      "blocks": [
        { "type": "category", "settings": { "title": "Passeio", "subtitle": "Coleiras, trelas e arneses" } },
        { "type": "category", "settings": { "title": "Conforto", "subtitle": "Camas, mantas e almofadas" } },
        { "type": "category", "settings": { "title": "Alimentação", "subtitle": "Taças, doseadores e tapetes" } },
        { "type": "category", "settings": { "title": "Brinquedos", "subtitle": "Mordedores e jogos de estímulo" } },
        { "type": "category", "settings": { "title": "Higiene", "subtitle": "Escovas, toalhas e cuidados" } },
        { "type": "category", "settings": { "title": "Viagem", "subtitle": "Transportadoras e acessórios" } }
      ]
    }
  ]
}
{% endschema %}
