<section class="section section--card" style="border-bottom:none">
  <div class="wrap">
    <div class="section-head"><div class="eyebrow" style="margin-bottom:12px">{{ section.settings.eyebrow }}</div><h2>{{ section.settings.heading }}</h2></div>
    <div class="reviews">
      {% for block in section.blocks %}
        <figure class="review" {{ block.shopify_attributes }}>
          <span class="stars" style="font-size:16px">{% for i in (1..5) %}{% if i <= block.settings.rating %}★{% else %}<span>★</span>{% endif %}{% endfor %}</span>
          <blockquote>“{{ block.settings.quote }}”</blockquote>
          <figcaption><strong>{{ block.settings.name }}</strong> · {{ block.settings.location }}</figcaption>
        </figure>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Testemunhos",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto pequeno (eyebrow)", "default": "Testemunhos" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Quem vive com HUKO, recomenda" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Testemunho",
      "settings": [
        { "type": "range", "id": "rating", "label": "Estrelas", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "quote", "label": "Citação", "default": "Escreve aqui o testemunho do cliente." },
        { "type": "text", "id": "name", "label": "Nome", "default": "Nome do cliente" },
        { "type": "text", "id": "location", "label": "Localização", "default": "Cidade" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testemunhos",
      "blocks": [
        { "type": "review", "settings": { "rating": 5, "quote": "A cama Oslo mudou as noites do nosso labrador. Qualidade que se vê e se sente.", "name": "Mariana S.", "location": "Lisboa" } },
        { "type": "review", "settings": { "rating": 5, "quote": "Finalmente uma loja pet que não parece um bazar. Entrega em 24h.", "name": "Ricardo P.", "location": "Porto" } },
        { "type": "review", "settings": { "rating": 5, "quote": "O arranhador Alta é o novo trono da nossa gata. Materiais excelentes.", "name": "Inês M.", "location": "Madrid" } }
      ]
    }
  ]
}
{% endschema %}
