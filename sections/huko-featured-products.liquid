<section class="section" id="bestsellers" data-screen-label="Mais vendidos">
  <div class="wrap">
    <div class="sec-head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.link_label != blank -%}
        <a href="{{ section.settings.link_url | default: routes.all_products_collection_url }}" class="link-arrow">{{ section.settings.link_label }}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" style="width:15px;height:15px"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
      {%- endif -%}
    </div>

    <div class="prod-grid" data-card="{{ section.settings.card_style }}">
      {%- liquid
        assign col = collections[section.settings.collection]
        assign limit = section.settings.product_limit
      -%}
      {%- if col != blank and col.products_count > 0 -%}
        {%- for product in col.products limit: limit -%}
          {% render 'huko-product-card', card_product: product %}
        {%- endfor -%}
      {%- else -%}
        {%- comment -%} Placeholder cards in the editor when no collection is chosen {%- endcomment -%}
        {%- for i in (1..limit) -%}
          <article class="pcard">
            <div class="pcard-media">
              <div class="r-media" style="aspect-ratio:1/1.12" data-ph="produto">{{ 'product-1' | placeholder_svg_tag: 'placeholder' }}</div>
            </div>
            <div class="pcard-body">
              <div class="pcard-rating"><span class="stars">★★★★★</span> 4,9</div>
              <h3>Nome do produto</h3>
              <div class="price">38&nbsp;€</div>
            </div>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Produtos em destaque",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sobre-título", "default": "Favoritos da comunidade" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Mais vendidos" },
    { "type": "collection", "id": "collection", "label": "Coleção" },
    { "type": "range", "id": "product_limit", "min": 2, "max": 12, "step": 1, "label": "Nº de produtos", "default": 8 },
    { "type": "select", "id": "card_style", "label": "Estilo dos cards", "options": [ { "value": "overlay", "label": "Sobreposto" }, { "value": "panel", "label": "Painel" } ], "default": "overlay" },
    { "type": "text", "id": "link_label", "label": "Texto do link", "default": "Ver todos os produtos" },
    { "type": "url", "id": "link_url", "label": "Link" }
  ],
  "presets": [ { "name": "Produtos em destaque" } ]
}
{% endschema %}
