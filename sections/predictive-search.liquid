{%- comment -%}
  Resultados da pesquisa preditiva. Esta secção nunca é colocada numa página:
  é pedida por search.js através de /search/suggest?...&section_id=predictive-search
  e o HTML devolvido é injetado no painel do header. Renderizar no servidor
  evita duplicar a formatação de preços e mantém a mesma linguagem visual.
{%- endcomment -%}
{%- assign results = predictive_search.resources.products -%}
{%- assign result_collections = predictive_search.resources.collections -%}

<div data-search-section>
  {%- if predictive_search.performed -%}
    {%- if results.size == 0 and result_collections.size == 0 -%}

      <div class="search-panel__empty">
        <p>Sem resultados para <strong>“{{ predictive_search.terms | escape }}”</strong>.</p>
        <p class="search-panel__empty-hint">Experimenta outra palavra ou explora as categorias do menu.</p>
      </div>

    {%- else -%}

      {%- if result_collections.size > 0 -%}
        <div class="search-panel__section">
          <span class="search-panel__label">Categorias</span>
          <div class="chips">
            {%- for result_collection in result_collections limit: 6 -%}
              <a href="{{ result_collection.url }}" class="chip">{{ result_collection.title }}</a>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}

      {%- if results.size > 0 -%}
        <div class="search-panel__section">
          <span class="search-panel__label">Produtos</span>
          <div class="search-grid">
            {%- for result_product in results -%}
              <a href="{{ result_product.url }}" class="search-card">
                <div class="search-card__img">
                  {%- if result_product.featured_image -%}
                    <img src="{{ result_product.featured_image | image_url: width: 320 }}" alt="{{ result_product.featured_image.alt | escape }}" loading="lazy" width="160" height="160">
                  {%- endif -%}
                </div>
                <span class="search-card__title">{{ result_product.title }}</span>
                <span class="search-card__price">
                  {%- if result_product.price_varies -%}
                    desde {{ result_product.price_min | money }}
                  {%- else -%}
                    {{ result_product.price | money }}
                  {%- endif -%}
                </span>
              </a>
            {%- endfor -%}
          </div>
        </div>

        <a href="{{ routes.search_url }}?q={{ predictive_search.terms | url_encode }}&type=product" class="search-panel__all">
          Ver todos os resultados para “{{ predictive_search.terms | escape }}”
          <span aria-hidden="true">→</span>
        </a>
      {%- endif -%}

    {%- endif -%}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Pesquisa preditiva"
}
{% endschema %}
