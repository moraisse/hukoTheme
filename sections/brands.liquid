{%- assign brand_files = '3_claveles.png,aeolus.png,agui.png,andis.png,antos.png,barry_king.png,burbur_aura.png,burbur_basics.png,burbur_friend.png,burbur_pro.png,cats_way.png,chris_christensen.png,classic.png,dingo_natura.jpg,easy_clean.png,flexy.png,freedog.png,groom_professional.png,groom_x.webp,groomtek.png,happy_pet.png,hau_miau.png,lolo_pets.png,lolo_pets_classic.png,max_biocide.png,milk_pepper.png,moderna.png,mp_bergamo.jpg,omega_paw.png,oudor_lock.jpg,panama_pet.png,pawppin.png,petuxe.png,red_dingo.png,sharper_blade.png,show_tech.webp,solidary.png,the_sentinel.jpg,tikima.png,transgroom.png,weego.png,yento.png' | split: ',' -%}

<section class="wrap brands" style="padding-top:8px;padding-bottom:96px" data-brands>
  <div class="section-head brands__head">
    <div>
      <div class="eyebrow" style="margin-bottom:12px">{{ section.settings.eyebrow }}</div>
      <h2 class="serif brands__title">{{ section.settings.heading }}</h2>
    </div>
    <div class="brands__nav">
      <button class="brands__btn" type="button" aria-label="Marcas anteriores" data-brands-prev>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
      </button>
      <button class="brands__btn" type="button" aria-label="Marcas seguintes" data-brands-next>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
      </button>
    </div>
  </div>

  <div class="brands__viewport">
    <div class="brands__track" data-brands-track>
      {%- for file in brand_files -%}
        {%- assign brand_key = file | split: '.' | first -%}
        {%- assign brand_handle = '' -%}
        {%- case brand_key -%}
          {%- when '3_claveles' -%}{%- assign brand_name = '3 Claveles' -%}{%- assign brand_handle = '3-claveles' -%}
          {%- when 'agui' -%}{%- assign brand_name = 'Agui' -%}{%- assign brand_handle = 'camas-agui' -%}
          {%- when 'andis' -%}{%- assign brand_name = 'Andis' -%}{%- assign brand_handle = 'andis' -%}
          {%- when 'antos' -%}{%- assign brand_name = 'Antos' -%}{%- assign brand_handle = 'antos' -%}
          {%- when 'barry_king' -%}{%- assign brand_name = 'Barry King' -%}{%- assign brand_handle = 'barry-king' -%}
          {%- when 'burbur_aura' -%}{%- assign brand_name = 'Burbur Aura' -%}{%- assign brand_handle = 'burbur' -%}
          {%- when 'burbur_basics' -%}{%- assign brand_name = 'Burbur Basics' -%}{%- assign brand_handle = 'burbur' -%}
          {%- when 'burbur_friend' -%}{%- assign brand_name = 'Burbur Friends' -%}{%- assign brand_handle = 'burbur' -%}
          {%- when 'burbur_pro' -%}{%- assign brand_name = 'Burbur Pro' -%}{%- assign brand_handle = 'burbur' -%}
          {%- when 'ca' -%}{%- assign brand_name = 'CA' -%}
          {%- when 'classic' -%}{%- assign brand_name = 'Classic' -%}
          {%- when 'dingo_natura' -%}{%- assign brand_name = 'Dingonatura' -%}{%- assign brand_handle = 'natura-diet' -%}
          {%- when 'flexy' -%}{%- assign brand_name = 'Flexi' -%}{%- assign brand_handle = 'flexi' -%}
          {%- when 'freedog' -%}{%- assign brand_name = 'Freedog' -%}{%- assign brand_handle = 'freedog' -%}
          {%- when 'groom_professional' -%}{%- assign brand_name = 'Groom Professional' -%}{%- assign brand_handle = 'groom-professional' -%}
          {%- when 'groomtek' -%}{%- assign brand_name = 'Groomtek' -%}{%- assign brand_handle = 'groomtek' -%}
          {%- when 'haquoss' -%}{%- assign brand_name = 'Haquoss' -%}
          {%- when 'hau_miau' -%}{%- assign brand_name = 'Hau&Miau' -%}{%- assign brand_handle = 'hau-miau' -%}
          {%- when 'lolo_pets' -%}{%- assign brand_name = 'Lolo Pets' -%}{%- assign brand_handle = 'lolo-pets' -%}
          {%- when 'lolo_pets_classic' -%}{%- assign brand_name = 'Lolo Pets Classic' -%}{%- assign brand_handle = 'lolo-pets' -%}
          {%- when 'max_biocide' -%}{%- assign brand_name = 'Max Biocide' -%}
          {%- when 'oudor_lock' -%}{%- assign brand_name = 'Odour Lock' -%}{%- assign brand_handle = 'odourlock' -%}
          {%- when 'panama_pet' -%}{%- assign brand_name = 'Panama Pet' -%}{%- assign brand_handle = 'panama-pet' -%}
          {%- when 'pawppin' -%}{%- assign brand_name = 'Pawppin' -%}{%- assign brand_handle = 'pawppin' -%}
          {%- when 'red_dingo' -%}{%- assign brand_name = 'Red Dingo' -%}{%- assign brand_handle = 'red-dingo' -%}
          {%- when 'transgroom' -%}{%- assign brand_name = 'Transgroom' -%}{%- assign brand_handle = 'transgroom' -%}
          {%- when 'aeolus' -%}{%- assign brand_name = "Aeolus" -%}{%- assign brand_handle = 'aeolus' -%}
          {%- when 'cats_way' -%}{%- assign brand_name = "Cat's Way" -%}{%- assign brand_handle = 'cats-way' -%}
          {%- when 'chris_christensen' -%}{%- assign brand_name = "Chris Christensen" -%}{%- assign brand_handle = 'chris-christensen' -%}
          {%- when 'easy_clean' -%}{%- assign brand_name = "Easy Clean" -%}{%- assign brand_handle = 'easy-clean' -%}
          {%- when 'groom_x' -%}{%- assign brand_name = "Groom-X" -%}{%- assign brand_handle = 'groom-x' -%}
          {%- when 'happy_pet' -%}{%- assign brand_name = "Happy Pet" -%}{%- assign brand_handle = 'happy-pet' -%}
          {%- when 'milk_pepper' -%}{%- assign brand_name = "Milk&Pepper" -%}{%- assign brand_handle = 'milk-pepper' -%}
          {%- when 'moderna' -%}{%- assign brand_name = "Moderna" -%}{%- assign brand_handle = 'moderna' -%}
          {%- when 'mp_bergamo' -%}{%- assign brand_name = "MP Bergamo" -%}{%- assign brand_handle = 'mp-bergamo' -%}
          {%- when 'omega_paw' -%}{%- assign brand_name = "Omega Paw" -%}{%- assign brand_handle = 'omega-paw' -%}
          {%- when 'petuxe' -%}{%- assign brand_name = "Petuxe" -%}{%- assign brand_handle = 'petuxe' -%}
          {%- when 'sharper_blade' -%}{%- assign brand_name = "Sharper Blade" -%}{%- assign brand_handle = 'sharper-blade' -%}
          {%- when 'show_tech' -%}{%- assign brand_name = "Show Tech" -%}{%- assign brand_handle = 'show-tech' -%}
          {%- when 'solidary' -%}{%- assign brand_name = "Solidary" -%}{%- assign brand_handle = 'solidary' -%}
          {%- when 'the_sentinel' -%}{%- assign brand_name = "The Sentinel" -%}{%- assign brand_handle = 'the-sentinel' -%}
          {%- when 'tikima' -%}{%- assign brand_name = "Tikima" -%}{%- assign brand_handle = 'tikima' -%}
          {%- when 'weego' -%}{%- assign brand_name = "Weego" -%}{%- assign brand_handle = 'weego' -%}
          {%- when 'yento' -%}{%- assign brand_name = "Yento" -%}{%- assign brand_handle = 'yento' -%}
          {%- else -%}{%- assign brand_name = brand_key | replace: '_', ' ' -%}
        {%- endcase -%}
        {%- comment -%}
          Com coleção de marca publicada e com produtos, o cartão leva a essa
          coleção (texto e SEO próprios); sem ela, o logótipo fica sem link.
        {%- endcomment -%}
        {%- assign brand_coll = collections[brand_handle] -%}
        {%- if brand_handle != blank and brand_coll != blank and brand_coll.products_count > 0 -%}
          <a class="brand-card" href="{{ brand_coll.url }}" aria-label="Ver produtos {{ brand_name | escape }}">
            <img src="{{ file | asset_url }}" alt="{{ brand_name | escape }}" loading="lazy" width="150" height="72">
          </a>
        {%- else -%}
          <div class="brand-card">
            <img src="{{ file | asset_url }}" alt="{{ brand_name | escape }}" loading="lazy" width="150" height="72">
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  .brands__head{text-align:left;display:flex;justify-content:space-between;align-items:flex-end;gap:24px}
  .brands__title{font-size:38px;margin:0}
  .brands__nav{display:flex;gap:10px;flex-shrink:0}
  .brands__btn{width:44px;height:44px;border-radius:999px;border:1.5px solid var(--line);background:#fff;color:var(--forest);
    display:inline-flex;align-items:center;justify-content:center;cursor:pointer;transition:all .18s ease}
  .brands__btn:hover{border-color:var(--green);background:var(--forest);color:#fff}
  .brands__btn:active{transform:scale(.94)}
  .brands__viewport{position:relative;margin-top:28px}
  /* esbatimentos nas pontas para dar sensação de faixa contínua */
  .brands__viewport::before,.brands__viewport::after{content:"";position:absolute;top:0;bottom:0;width:64px;z-index:2;pointer-events:none}
  .brands__viewport::before{left:0;background:linear-gradient(90deg,var(--bg),transparent)}
  .brands__viewport::after{right:0;background:linear-gradient(270deg,var(--bg),transparent)}
  .brands__track{display:flex;gap:24px;overflow-x:auto;scroll-behavior:smooth;scroll-snap-type:x proximity;
    padding:4px;-ms-overflow-style:none;scrollbar-width:none}
  .brands__track::-webkit-scrollbar{display:none}
  .brand-card{flex:0 0 auto;width:200px;height:132px;background:#fff;border:1px solid var(--line);border-radius:16px;
    display:flex;align-items:center;justify-content:center;padding:26px;scroll-snap-align:start;
    box-shadow:0 6px 18px rgba(30,61,47,.05);transition:transform .2s ease,box-shadow .2s ease,border-color .2s ease}
  .brand-card:hover{transform:translateY(-4px);box-shadow:0 16px 34px rgba(30,61,47,.12);border-color:var(--gold)}
  .brand-card img{max-width:100%;max-height:100%;width:auto;height:auto;object-fit:contain;
    filter:grayscale(.4);opacity:.85;transition:filter .2s ease,opacity .2s ease}
  .brand-card:hover img{filter:grayscale(0);opacity:1}
  @media(max-width:768px){
    .brands__title{font-size:28px}
    .brand-card{width:158px;height:110px;padding:20px}
    .brands__viewport::before,.brands__viewport::after{width:32px}
  }
</style>

<script>
  (function () {
    document.querySelectorAll('[data-brands]').forEach(function (root) {
      var track = root.querySelector('[data-brands-track]');
      if (!track) return;
      var prev = root.querySelector('[data-brands-prev]');
      var next = root.querySelector('[data-brands-next]');
      var GAP = 24;
      var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      function stepAmount() {
        var card = track.querySelector('.brand-card');
        return card ? card.offsetWidth + GAP : 224;
      }
      function atEnd() { return track.scrollLeft + track.clientWidth >= track.scrollWidth - 4; }
      function atStart() { return track.scrollLeft <= 4; }
      function go(dir) {
        if (dir > 0 && atEnd()) { track.scrollTo({ left: 0, behavior: 'smooth' }); return; }
        if (dir < 0 && atStart()) { track.scrollTo({ left: track.scrollWidth, behavior: 'smooth' }); return; }
        track.scrollBy({ left: dir * stepAmount(), behavior: 'smooth' });
      }

      if (next) next.addEventListener('click', function () { go(1); restart(); });
      if (prev) prev.addEventListener('click', function () { go(-1); restart(); });

      var timer = null;
      function start() { if (!reduce) timer = setInterval(function () { go(1); }, 3200); }
      function stop() { if (timer) { clearInterval(timer); timer = null; } }
      function restart() { stop(); start(); }

      track.addEventListener('mouseenter', stop);
      track.addEventListener('mouseleave', start);
      track.addEventListener('touchstart', stop, { passive: true });
      start();
    });
  })();
</script>

{% schema %}
{
  "name": "Marcas",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto pequeno (eyebrow)", "default": "Parceiros de confiança" },
    { "type": "text", "id": "heading", "label": "Título", "default": "As marcas com que trabalhamos" }
  ],
  "presets": [{ "name": "Marcas" }]
}
{% endschema %}
