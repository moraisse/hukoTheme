{%- paginate collection.products by section.settings.per_page -%}
<section class="section" data-screen-label="Coleção">
  <div class="wrap">
    <div class="sec-head">
      <div>
        <span class="eyebrow">{{ collection.products_count }} produtos</span>
        <h2>{{ collection.title }}</h2>
        {%- if collection.description != blank -%}<p>{{ collection.description | strip_html | truncatewords: 30 }}</p>{%- endif -%}
      </div>
    </div>

    {%- if collection.products.size > 0 -%}
      <div class="prod-grid" data-card="{{ section.settings.card_style }}">
        {%- for product in collection.products -%}
          {% render 'huko-product-card', card_product: product %}
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <div style="display:flex;gap:8px;justify-content:center;margin-top:48px">
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}
              <a class="btn btn-outline" href="{{ part.url }}" style="padding:10px 16px">{{ part.title }}</a>
            {%- else -%}
              <span class="btn btn-dark" style="padding:10px 16px">{{ part.title }}</span>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- else -%}
      <p style="font-family:var(--font-ui);color:var(--muted);text-align:center;padding:60px 0">Ainda não há produtos nesta coleção.</p>
    {%- endif -%}
  </div>
</section>
{%- endpaginate -%}

{% schema %}
{
  "name": "Grelha da coleção",
  "settings": [
    { "type": "range", "id": "per_page", "min": 8, "max": 24, "step": 4, "label": "Produtos por página", "default": 12 },
    { "type": "select", "id": "card_style", "label": "Estilo dos cards", "options": [ { "value": "overlay", "label": "Sobreposto" }, { "value": "panel", "label": "Painel" } ], "default": "overlay" }
  ]
}
{% endschema %}
