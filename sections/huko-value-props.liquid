<section class="vp section" data-screen-label="Proposta de valor">
  <div class="wrap vp-grid">
    {%- for block in section.blocks -%}
      <div class="vp-item" {{ block.shopify_attributes }}>
        <div class="vp-ic">{% render 'huko-icon', name: block.settings.icon %}</div>
        <h3>{{ block.settings.title }}</h3>
        {%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p>{%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Proposta de valor",
  "blocks": [
    {
      "type": "prop",
      "name": "Benefício",
      "settings": [
        { "type": "select", "id": "icon", "label": "Ícone", "options": [
          { "value": "shield", "label": "Escudo" },
          { "value": "sliders", "label": "Controlos" },
          { "value": "truck", "label": "Envio" },
          { "value": "heart", "label": "Coração" },
          { "value": "leaf", "label": "Folha" },
          { "value": "star", "label": "Estrela" }
        ], "default": "shield" },
        { "type": "text", "id": "title", "label": "Título", "default": "Materiais selecionados" },
        { "type": "textarea", "id": "text", "label": "Texto", "default": "Tecidos, metais e fibras escolhidos pela durabilidade e pelo toque." }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Proposta de valor",
      "blocks": [
        { "type": "prop", "settings": { "icon": "shield", "title": "Materiais selecionados", "text": "Tecidos, metais e fibras escolhidos pela durabilidade e pelo toque — testados no dia a dia." } },
        { "type": "prop", "settings": { "icon": "sliders", "title": "Design funcional", "text": "Cada peça resolve um problema real — pensada para o pet e para a tua casa." } },
        { "type": "prop", "settings": { "icon": "truck", "title": "Envio rápido na Europa", "text": "Expedição em 24–48h e entregas acompanhadas em toda a União Europeia." } },
        { "type": "prop", "settings": { "icon": "heart", "title": "Pensado para o bem-estar", "text": "Conforto, segurança e calma — produtos que respeitam o ritmo do animal." } }
      ]
    }
  ]
}
{% endschema %}
