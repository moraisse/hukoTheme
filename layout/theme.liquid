<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  {%- comment -%}
    Sufixo " — hukopets.com" só se o título ainda não tiver o nome da loja e o
    total não passar de 60 caracteres (o que o Google costuma mostrar).
  {%- endcomment -%}
  {%- assign page_title_down = page_title | downcase -%}
  {%- assign title_suffix = ' — ' | append: shop.name -%}
  {%- assign title_full_size = page_title | append: title_suffix | size -%}
  {%- assign title_use_suffix = true -%}
  {%- if page_title_down contains 'hukopets' or title_full_size > 60 -%}{%- assign title_use_suffix = false -%}{%- endif %}
  <title>{{ page_title }}{% if title_use_suffix %}{{ title_suffix }}{% endif %}</title>
  {%- comment -%} Listagens de fornecedor: o Google deve preferir as coleções de marca. {%- endcomment -%}
  {%- if template.name == 'collection' and collection.handle == 'vendors' -%}
  <meta name="robots" content="noindex,follow">
  {%- endif %}
  <link rel="icon" type="image/png" sizes="192x192" href="{{ 'favicon.png' | asset_url }}">
  <link rel="apple-touch-icon" href="{{ 'favicon.png' | asset_url }}">
  {%- comment -%} Mapa do site (template page.sitemap) tem descrição própria. {%- endcomment -%}
  {%- assign meta_description = page_description -%}
  {%- if template.name == 'page' and template.suffix == 'sitemap' -%}
    {%- assign meta_description = 'Mapa do site da Hukopets: todas as categorias, marcas e produtos para cães, gatos e grooming profissional, organizados por coleção.' -%}
  {%- endif %}
  {%- comment -%} Open Graph / Twitter (partilhas em redes sociais), em todas as páginas. {%- endcomment -%}
  {%- assign og_type = 'website' -%}
  {%- if template.name == 'product' -%}{%- assign og_type = 'product' -%}{%- elsif template.name == 'article' -%}{%- assign og_type = 'article' -%}{%- endif -%}
  {%- assign og_description = meta_description | default: shop.description %}
  <meta property="og:site_name" content="HUKO pets">
  <meta property="og:title" content="{{ page_title | escape }}">
  {%- if og_description != blank %}
  <meta property="og:description" content="{{ og_description | escape }}">
  {%- endif %}
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:type" content="{{ og_type }}">
  <meta name="twitter:card" content="summary">
  <script type="application/ld+json">
  {"@context":"https://schema.org","@type":"WebSite","name":"HUKO pets","url":"https://hukopets.com/"}
  </script>
  {% if meta_description %}<meta name="description" content="{{ meta_description | escape }}">{% endif %}
  {%- comment -%} Paginação de coleções e pesquisa (variáveis definidas nos templates). {%- endcomment -%}
  {%- if pagination_prev_url %}
  <link rel="prev" href="{{ pagination_prev_url }}">
  {%- endif -%}
  {%- if pagination_next_url %}
  <link rel="next" href="{{ pagination_next_url }}">
  {%- endif %}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@400;500;600;700;800&family=Hanken+Grotesk:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  <style>
    /* ===== Mega-menu multi-coluna (desktop) ===== */
    /* A categoria pai preenche toda a altura da linha das categorias e o painel encosta ao
       fundo dessa linha (sem espaço), por isso o hover nunca se perde ao descer do texto
       para o painel. */
    .site-header__inner{position:relative}
    .site-nav{align-self:stretch}
    /* position:static é essencial: é o que faz o painel abrir à largura toda do header. */
    .nav-item--parent{position:static;align-self:stretch;display:flex;align-items:center}
    .nav-mega{position:absolute;top:100%;left:0;right:0;background:#fff;
      border:1px solid var(--line);border-top:none;border-radius:0 0 20px 20px;
      box-shadow:0 26px 50px rgba(30,61,47,.15);display:flex;overflow:hidden;
      opacity:0;visibility:hidden;pointer-events:none;transform:translateY(6px);
      transition:opacity .16s ease,transform .16s ease;z-index:120}
    .nav-item--parent:hover .nav-mega,.nav-item--parent:focus-within .nav-mega{opacity:1;visibility:visible;pointer-events:auto;transform:translateY(0)}
    /* colunas das categorias de 2º nível (fluem em 4 colunas, como o modelo de referência) */
    .nav-mega__cols{flex:1;padding:36px 44px 40px;columns:4;column-gap:36px}
    .nav-mega__group{break-inside:avoid;-webkit-column-break-inside:avoid;margin-bottom:26px}
    .nav-mega__group:last-child{margin-bottom:0}
    .nav-mega__grouptitle{display:block;font-family:var(--serif);font-weight:700;font-size:15px;
      color:var(--forest);letter-spacing:-.01em;margin-bottom:11px;border-bottom:none;transition:color .15s}
    .nav-mega__grouptitle:hover{color:var(--green)}
    .nav-mega__links{display:flex;flex-direction:column;border-left:1px solid var(--line);padding-left:15px}
    .nav-mega__link{padding:6px 0;font-size:14px;font-weight:400;color:var(--muted);line-height:1.35;border-bottom:none;transition:color .15s}
    .nav-mega__link:hover{color:var(--forest);text-decoration:underline;text-decoration-color:var(--green);text-decoration-thickness:2px;text-underline-offset:4px}
    /* imagem promocional à direita (usa a imagem da coleção da categoria pai, se existir) */
    .nav-mega__media{position:relative;width:290px;flex-shrink:0;align-self:stretch;display:block;border-bottom:none;overflow:hidden}
    .nav-mega__media img{width:100%;height:100%;min-height:100%;object-fit:cover}
    .nav-mega__media-label{position:absolute;left:0;right:0;bottom:0;padding:20px 22px 16px;font-size:14px;font-weight:600;color:#fff;
      background:linear-gradient(transparent,rgba(26,26,26,.78))}
    @media(max-width:1150px){.nav-mega__cols{columns:3}.nav-mega__media{display:none}}
    @media(max-width:900px){.nav-mega{display:none}}
    /* ===== Mobile: 3º nível (acordeão aninhado) ===== */
    .mobile-nav__group--2{border-bottom:none;border-top:1px solid var(--line)}
    .mobile-nav__group--2:first-child{border-top:none}
    .mobile-nav__sublink--parent{flex:1}
    .mobile-nav__group--2 .mobile-nav__row .mobile-nav__expand{padding:12px 10px;color:var(--soft)}
    .mobile-nav__sublink--3{padding:11px 10px 11px 40px;font-size:14.5px;color:var(--soft)}
    .mobile-nav__sublink--3:hover{color:var(--forest)}
    .mobile-nav__group--2 .mobile-nav__sub-inner .mobile-nav__sublink--3:first-child{padding-top:4px}
    .mobile-nav__group--2 .mobile-nav__sub-inner .mobile-nav__sublink--3:last-child{padding-bottom:12px}
  </style>
  {{ content_for_header }}
</head>
<div id="discount-banner" hidden style="position:fixed;bottom:20px;left:50%;transform:translateX(-50%);z-index:999;background:#1f7a4d;color:#fff;padding:14px 22px;border-radius:12px;font-size:15px;box-shadow:0 6px 20px rgba(0,0,0,.15)"></div>
<script>
  (function () {
    var m = document.cookie.match(/(?:^|; )discount_code=([^;]+)/);
    if (!m) return;
    var code = decodeURIComponent(m[1]);
    var key = 'discount_seen_' + code;
    try {
      if (localStorage.getItem(key)) return;
      localStorage.setItem(key, '1');
    } catch (e) { return; }
    var b = document.getElementById('discount-banner');
    b.textContent = '🐾 Código ' + code + ' aplicado! O desconto aparece no carrinho e no checkout.';
    b.hidden = false;
    setTimeout(function () { b.hidden = true; }, 7000);
  })();
</script>
{%- capture grooming_context -%}{%- render 'grooming-context', current_collection: collection, current_product: product -%}{%- endcapture -%}
{%- assign grooming_context = grooming_context | strip -%}
{%- assign grooming_root = linklists.main-menu.links | where: 'handle', 'grooming' | first -%}
{%- capture grooming_destination -%}{%- render 'grooming-url' -%}{%- endcapture -%}
{%- assign is_grooming = false -%}
{%- if grooming_context == 'true' -%}{%- assign is_grooming = true -%}{%- endif -%}
{%- assign grooming_handle_prefix = collection.handle | slice: 0, 9 -%}
{%- if collection.handle == 'grooming' or grooming_handle_prefix == 'grooming-' -%}{%- assign is_grooming = true -%}{%- endif -%}
<body class="template-{{ request.page_type }}{% if is_grooming %} space-grooming{% endif %}">

  <header class="site-header">
    <div class="wrap site-header__inner">
      <button class="nav-toggle" aria-label="Abrir menu" aria-expanded="false" aria-controls="mobile-drawer">
        <span class="nav-toggle__bars" aria-hidden="true"><span></span><span></span><span></span></span>
      </button>
      {%- comment -%}
        Marca: logo em cima e assinatura por baixo, ocupando as duas linhas da
        grelha — é o que dá peso ao canto esquerdo e equilibra a linha das
        categorias, como nos exemplos de referência.
      {%- endcomment -%}
      <div class="site-header__brand">
        <a href="{{ routes.root_url }}" class="site-header__logo">
          {%- comment -%}
            O header é verde-escuro, por isso a versão por omissão é a clara — a
            mesma que o rodapé usa. Um logo carregado nas definições tem de ser
            igualmente claro para se ver.
          {%- endcomment -%}
          {% if settings.logo != blank %}
            <img src="{{ settings.logo | image_url: width: 420 }}" alt="{{ shop.name }}">
          {% else %}
            <img src="{{ 'huko-logo-light.svg' | asset_url }}" alt="{{ shop.name }}">
          {% endif %}
        </a>
        {%- comment -%}
          Sem filtro `default` de propósito: assim, esvaziar o campo nas
          definições esconde mesmo a assinatura (o valor inicial vem do schema).
        {%- endcomment -%}
        {%- if settings.header_tagline != blank -%}
          <span class="site-header__tagline">{{ settings.header_tagline }}</span>
        {%- endif -%}
      </div>
      {%- comment -%}
        A pesquisa e os portes grátis andam juntos: ficam no mesmo flex, encostados
        um ao outro, por isso quando a barra cresce ao ser clicada o bloco dos
        portes desliza com ela.
      {%- endcomment -%}
      <div class="header-mid">
        {% render 'header-search' %}

        {%- assign ship_threshold = settings.free_shipping_threshold | default: 45 -%}
        {%- if shop.shipping_policy.url != blank -%}
          {%- assign perk_tag = 'a' -%}
        {%- else -%}
          {%- assign perk_tag = 'div' -%}
        {%- endif -%}
        <{{ perk_tag }} class="header-perk"{% if perk_tag == 'a' %} href="{{ shop.shipping_policy.url }}"{% endif %}>
          <svg class="header-perk__icon" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="1" y="4.5" width="14" height="11" rx="1.5"/>
            <path d="M15 8h4l4 3.5v4H15z"/>
            <circle cx="6" cy="18" r="2.2"/>
            <circle cx="18" cy="18" r="2.2"/>
          </svg>
          <span class="header-perk__text">
            <strong>Portes grátis</strong>
            <span>a partir de {{ ship_threshold }}€</span>
          </span>
        </{{ perk_tag }}>
      </div>

      <div class="header-icons">
        <a href="{{ routes.account_url }}" aria-label="Conta"><svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke-width="1.6"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-6.5 8-6.5s8 2.5 8 6.5"/></svg></a>
        <div class="cart-wrap">
          <a href="{{ routes.cart_url }}" class="cart-link" aria-label="Carrinho" aria-haspopup="dialog" aria-controls="mini-cart">
            <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke-width="1.6"><path d="M5 8h14l-1.2 12H6.2L5 8z"/><path d="M8.5 8V6.5a3.5 3.5 0 0 1 7 0V8"/></svg>
            <span class="cart-count{% if cart.item_count > 0 %} is-visible{% endif %}">{{ cart.item_count }}</span>
          </a>
          {% render 'mini-cart' %}
        </div>
      </div>

      {%- comment -%}
        As categorias ficam na segunda linha da mesma grelha, a começar na coluna
        da pesquisa — por isso alinham sempre com ela, seja qual for a largura do logo.
      {%- endcomment -%}
      {%- assign grooming_links = linklists.main-menu.links | where: 'handle', 'grooming' -%}
      {%- assign navigation_links = linklists.main-menu.links | reject: 'handle', 'grooming' | concat: grooming_links -%}
      <nav class="site-nav">
          {% for link in navigation_links %}
          {%- assign navigation_url = link.url -%}
          {%- if link.handle == 'grooming' -%}{%- assign navigation_url = grooming_destination -%}{%- endif -%}
          {%- capture navigation_label -%}
            {%- if link.handle == 'grooming' -%}
              <span class="nav-grooming__label">{{ link.title }} <span class="nav-grooming__badge">{{ 'general.navigation.pro' | t }}</span></span>
            {%- else -%}
              {{ link.title }}
            {%- endif -%}
          {%- endcapture -%}
          {%- if link.links.size > 0 -%}
            <div class="nav-item nav-item--parent{% if link.handle == 'grooming' %} nav-item--grooming{% endif %}">
              <a href="{{ navigation_url }}" class="nav-item__link" aria-haspopup="true" aria-expanded="false">{{ navigation_label }}</a>
              {%- assign mega_img = link.object.image -%}
              <div class="nav-mega" role="menu">
                <div class="nav-mega__cols">
                  {%- for child in link.links -%}
                    <div class="nav-mega__group">
                      <a href="{{ child.url }}" class="nav-mega__grouptitle" role="menuitem">{{ child.title }}</a>
                      {%- if child.links.size > 0 -%}
                        <div class="nav-mega__links">
                          {%- for grandchild in child.links -%}
                            <a href="{{ grandchild.url }}" class="nav-mega__link" role="menuitem">{{ grandchild.title }}</a>
                          {%- endfor -%}
                        </div>
                      {%- endif -%}
                    </div>
                  {%- endfor -%}
                </div>
                {%- if mega_img != blank -%}
                  <a href="{{ navigation_url }}" class="nav-mega__media">
                    <img src="{{ mega_img | image_url: width: 600 }}" alt="{{ link.title }}" loading="lazy" width="290" height="440">
                    <span class="nav-mega__media-label">Ver tudo em {{ link.title }} →</span>
                  </a>
                {%- endif -%}
              </div>
            </div>
          {%- else -%}
            <div class="nav-item{% if link.handle == 'grooming' %} nav-item--grooming{% endif %}">
              <a href="{{ navigation_url }}" class="nav-item__link">{{ navigation_label }}</a>
            </div>
          {%- endif -%}
          {% endfor %}

          {%- comment -%}
            "Marcas" não vem do menu do lojista: é o tema que o acrescenta, com o
            diretório de marcas como painel. O botão só abre o painel — quem
            navega são as marcas lá dentro.
          {%- endcomment -%}
          <div class="nav-item nav-item--parent nav-item--brands">
            <button type="button" class="nav-item__link" aria-haspopup="true" aria-expanded="false">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="7" cy="8" r="3.2"/><circle cx="17" cy="8" r="3.2"/><rect x="8.8" y="14.5" width="6.4" height="6.4" rx="1.4"/></svg>
              Marcas
            </button>
            <div class="nav-mega nav-mega--brands" role="menu">
              {% render 'brands-directory' %}
            </div>
          </div>
      </nav>
    </div>
  </header>

  <div class="mobile-drawer" id="mobile-drawer" aria-hidden="true">
    <div class="mobile-drawer__overlay" data-drawer-close></div>
    <aside class="mobile-drawer__panel" role="dialog" aria-modal="true" aria-label="Menu de navegação">
      <div class="mobile-drawer__head">
        <span class="mobile-drawer__title">Menu</span>
        <button class="mobile-drawer__close" aria-label="Fechar menu" data-drawer-close>
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><line x1="6" y1="6" x2="18" y2="18"/><line x1="18" y1="6" x2="6" y2="18"/></svg>
        </button>
      </div>
      <nav class="mobile-nav">
        {% for link in navigation_links %}
          {%- assign navigation_url = link.url -%}
          {%- if link.handle == 'grooming' -%}{%- assign navigation_url = grooming_destination -%}{%- endif -%}
          {%- capture navigation_label -%}
            {%- if link.handle == 'grooming' -%}
              <span class="nav-grooming__label">{{ link.title }} <span class="nav-grooming__badge">{{ 'general.navigation.pro' | t }}</span></span>
            {%- else -%}
              {{ link.title }}
            {%- endif -%}
          {%- endcapture -%}
          {%- if link.links.size > 0 -%}
            <div class="mobile-nav__group{% if link.handle == 'grooming' %} mobile-nav__group--grooming{% endif %}">
              <div class="mobile-nav__row">
                <a href="{{ navigation_url }}" class="mobile-nav__link">{{ navigation_label }}</a>
                <button class="mobile-nav__expand" aria-label="Mostrar subcategorias de {{ link.title }}" aria-expanded="false">
                  <svg width="14" height="14" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 3.5 5 6.5 8 3.5"/></svg>
                </button>
              </div>
              <div class="mobile-nav__sub">
                <div class="mobile-nav__sub-inner">
                  {%- for child in link.links -%}
                    {%- if child.links.size > 0 -%}
                      <div class="mobile-nav__group mobile-nav__group--2">
                        <div class="mobile-nav__row">
                          <a href="{{ child.url }}" class="mobile-nav__sublink mobile-nav__sublink--parent">{{ child.title }}</a>
                          <button class="mobile-nav__expand" aria-label="Mostrar subcategorias de {{ child.title }}" aria-expanded="false">
                            <svg width="13" height="13" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 3.5 5 6.5 8 3.5"/></svg>
                          </button>
                        </div>
                        <div class="mobile-nav__sub">
                          <div class="mobile-nav__sub-inner">
                            {%- for grandchild in child.links -%}
                              <a href="{{ grandchild.url }}" class="mobile-nav__sublink mobile-nav__sublink--3">{{ grandchild.title }}</a>
                            {%- endfor -%}
                          </div>
                        </div>
                      </div>
                    {%- else -%}
                      <a href="{{ child.url }}" class="mobile-nav__sublink">{{ child.title }}</a>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              </div>
            </div>
          {%- else -%}
            <a href="{{ navigation_url }}" class="mobile-nav__link mobile-nav__link--solo{% if link.handle == 'grooming' %} mobile-nav__link--grooming{% endif %}">{{ navigation_label }}</a>
          {%- endif -%}
        {% endfor %}

        {%- comment -%} Mesmas marcas do painel de desktop, em acordeão. {%- endcomment -%}
        {%- capture drawer_raw -%}{% render 'brand-collections' %}{%- endcapture -%}
        {%- assign drawer_brands = drawer_raw | strip | split: '~|~' -%}
        {%- if drawer_brands.size > 0 -%}
          <div class="mobile-nav__group">
            <div class="mobile-nav__row">
              <span class="mobile-nav__link">Marcas</span>
              <button class="mobile-nav__expand" aria-label="Mostrar marcas" aria-expanded="false">
                <svg width="14" height="14" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 3.5 5 6.5 8 3.5"/></svg>
              </button>
            </div>
            <div class="mobile-nav__sub">
              <div class="mobile-nav__sub-inner">
                {%- for entry in drawer_brands -%}
                  {%- assign b_handle = entry | split: '|' | last -%}
                  <a href="{{ collections[b_handle].url }}" class="mobile-nav__sublink">{{ entry | split: '|' | first }}</a>
                {%- endfor -%}
              </div>
            </div>
          </div>
        {%- endif -%}
      </nav>
    </aside>
  </div>

  <main>
    {%- comment -%} H1 único da home (os títulos dos slides são h2). {%- endcomment -%}
    {%- if template.name == 'index' -%}
      <h1 class="visually-hidden">Hukopets — loja online de produtos para cães, gatos e grooming profissional</h1>
    {%- endif %}
    {% if is_grooming %}
      <div class="grooming-space-bar">
        <div class="wrap">
          <a href="{{ grooming_destination }}">Grooming <span class="nav-grooming__badge">{{ 'general.navigation.pro' | t }}</span></a>
          <span>{{ 'general.grooming.professional' | t }}</span>
        </div>
      </div>
    {% endif %}
    {% render 'breadcrumb' %}
    {{ content_for_layout }}
  </main>

  <section class="newsletter">
    <div class="newsletter__inner">
      <div class="eyebrow">{% if is_grooming %}{{ 'general.grooming.professional' | t }}{% else %}Junte-se à matilha{% endif %}</div>
      <h2 class="serif">Novidades, lançamentos e <em>10% de desconto</em> na primeira compra</h2>
      <p>Sem spam. Apenas o essencial, uma vez por mês.</p>
      {% form 'customer' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input type="email" name="contact[email]" placeholder="O seu email" required>
        <button type="submit">Receber novidades</button>
      {% endform %}
    </div>
  </section>

  <footer class="site-footer">
    <div class="wrap">
      <div class="site-footer__cols">
        <div class="site-footer__brand">
          <img src="{{ 'huko-logo-light.svg' | asset_url }}" alt="{{ shop.name }}">
          <p>Acessórios premium para animais de estimação. Selecionados com carinho, enviados com rapidez.</p>
        </div>
        <div>
          <p class="footer__heading">Loja</p>
          {% for link in linklists.main-menu.links limit: 4 %}
            {% unless link.handle == 'grooming' %}<a href="{{ link.url }}">{{ link.title }}</a>{% endunless %}
          {% endfor %}
          {% for link in grooming_links %}
            <div class="footer-grooming">
              <a href="{{ grooming_destination }}" class="footer-grooming__link">
                <span class="nav-grooming__label">{{ link.title }} <span class="nav-grooming__badge">{{ 'general.navigation.pro' | t }}</span></span>
              </a>
            </div>
          {% endfor %}
        </div>
        <div>
          <p class="footer__heading">Apoio ao cliente</p>
          {% for link in linklists.footer.links %}{% unless link.title == 'Busca' %}<a href="{{ link.url }}">{{ link.title }}</a>{% endunless %}{% endfor %}
          {%- comment -%} Mapa do site: ligação fixa enquanto a página existir (handle mapa-do-site). {%- endcomment -%}
