  {%- comment -%}
    Cartões de produto: o href é o URL canónico; se o cartão mostra outra variante
    (data-variant-id, ver snippets/product-card.liquid), o clique simples abre-a.
    Cliques com modificadores (novo separador, etc.) seguem o href limpo.
  {%- endcomment -%}
  <script>
    document.addEventListener('click', function (e) {
      var link = e.target.closest && e.target.closest('a[data-variant-id]');
      if (!link || e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      e.preventDefault();
      window.location.href = link.href + (link.href.indexOf('?') === -1 ? '?' : '&') + 'variant=' + link.getAttribute('data-variant-id');
    });
  </script>
