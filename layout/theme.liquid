<!doctype html>
<html lang="{{ request.locale.iso_code }}" data-type="{{ settings.heading_style | default: 'editorial' }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="{{ settings.color_cream | default: '#FAF8F3' }}">
  <link rel="canonical" href="{{ canonical_url }}">
  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {%- endif -%}

  <title>{{ page_title }}{% if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif %}{% if current_page != 1 %} &ndash; {{ 'general.page' | t }} {{ current_page }}{% endif %}{% unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}</title>

  {%- if page_description -%}<meta name="description" content="{{ page_description | escape }}">{%- endif -%}

  {{ content_for_header }}

  {{ 'huko.css' | asset_url | stylesheet_tag }}

  {%- comment -%} Theme colour overrides from settings {%- endcomment -%}
  <style>
    :root{
      --green:{{ settings.color_green | default: '#2ECC71' }};
      --ink:{{ settings.color_ink | default: '#1A1A1A' }};
      --cream:{{ settings.color_cream | default: '#FAF8F3' }};
      --forest:{{ settings.color_forest | default: '#1E3D2F' }};
      --gold:{{ settings.color_gold | default: '#C9B27A' }};
    }
  </style>

  <script>
    window.Shopify = window.Shopify || {};
    window.Shopify.routes = window.Shopify.routes || {};
    window.Shopify.routes.root = "{{ routes.root_url }}";
  </script>
</head>
<body class="template-{{ request.page_type | handle }}">

  {% section 'huko-header' %}

  <main id="MainContent" role="main">
    {{ content_for_layout }}
  </main>

  {% section 'huko-footer' %}
  {% section 'huko-cart-drawer' %}

  {{ 'huko.js' | asset_url | script_tag }}
</body>
</html>
