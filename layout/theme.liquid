<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ page_title }}{% unless page_title contains shop.name %} — {{ shop.name }}{% endunless %}</title>
  {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@400;500;600;700;800&family=Hanken+Grotesk:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  <style>
    /* ===== Mega-menu de 3 níveis (desktop) ===== */
    .nav-mega{position:absolute;top:100%;left:0;margin-top:12px;background:#fff;border:1px solid var(--line);border-radius:16px;
      box-shadow:0 18px 44px rgba(30,61,47,.16);display:flex;overflow:hidden;
      opacity:0;visibility:hidden;pointer-events:none;transform:translateY(6px);
      transition:opacity .18s ease,transform .18s ease;z-index:120}
    /* ponte invisível sobre o espaço de 12px, para o hover não se perder ao descer do texto para o painel.
       Fica no nav-item--parent porque o .nav-mega tem overflow:hidden e cortaria um pseudo-elemento próprio. */
    .nav-item--parent::after{content:"";position:absolute;top:100%;left:0;right:0;height:16px}
    .nav-mega--split{min-width:580px}
    .nav-item--parent:hover .nav-mega,.nav-item--parent:focus-within .nav-mega{opacity:1;visibility:visible;pointer-events:auto;transform:translateY(0)}
    /* itens mais à direita abrem alinhados à direita para não sair do ecrã */
    .nav-item--parent:last-child .nav-mega,.nav-item--parent:nth-last-child(2) .nav-mega{left:auto;right:0}
    /* coluna nível 2 */
    .nav-mega__l2{width:290px;flex-shrink:0;padding:14px;display:flex;flex-direction:column;gap:2px}
    .nav-mega:not(.nav-mega--split) .nav-mega__l2{width:230px}
    .nav-mega__l2link{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:11px 15px;border-radius:10px;
      font-size:14.5px;font-weight:500;color:var(--ink);border-bottom:none;transition:background .15s,color .15s}
    .nav-mega__l2link:hover,.nav-mega__l2link.is-active{background:var(--bg);color:var(--forest)}
    .nav-mega__l2caret{stroke:currentColor;flex-shrink:0;opacity:.45;transition:opacity .15s,color .15s}
    .nav-mega__l2link:hover .nav-mega__l2caret,.nav-mega__l2link.is-active .nav-mega__l2caret{opacity:1;color:var(--green)}
    /* painel nível 3 (coluna direita) */
    .nav-mega__panel{flex:1;min-width:270px;background:#F6F3EC;border-left:1px solid var(--line);padding:20px 22px}
    .nav-mega__sub{display:none;flex-direction:column;gap:2px}
    .nav-mega__sub.is-active{display:flex}
    .nav-mega__sub-title{font-family:var(--serif);font-size:12px;letter-spacing:.14em;text-transform:uppercase;
      color:var(--gold);font-weight:600;margin:0 0 10px;padding:0 12px}
    .nav-mega__sublink{padding:9px 12px;border-radius:8px;font-size:14px;font-weight:400;color:#4A4A44;border-bottom:none;transition:background .15s,color .15s}
    .nav-mega__sublink:hover{background:#fff;color:var(--forest)}
    @media(max-width:900px){.nav-mega{display:none}}
    /* ===== Mobile: 3º nível (acordeão aninhado) ===== */
    .mobile-nav__group--2{border-bottom:none;border-top:1px solid var(--line)}
    .mobile-nav__group--2:first-child{border-top:none}
    .mobile-nav__sublink--parent{flex:1}
    .mobile-nav__group--2 .mobile-nav__row .mobile-nav__expand{padding:12px 10px;color:var(--soft)}
    .mobile-nav__sublink--3{padding:11px 10px 11px 40px;font-size:14.5px;color:var(--soft)}
    .mobile-nav__sublink--3:hover{color:var(--forest)}
    .mobile-nav__group--2 .mobile-nav__sub-inner .mobile-nav__sublink--3:first-child{padding-top:4px}
    .mobile-nav__group--2 .mobile-nav__sub-inner .mobile-nav__sublink--3:last-child{padding-bottom:12px}
  </style>
  {{ content_for_header }}
</head>
<body class="template-{{ request.page_type }}">

  <div class="announce">
    <div class="announce__inner wrap">
      <span class="announce__msg">{{ settings.announcement_text }}</span>
      <a href="tel:+351931198604" class="announce__phone">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.362 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.338 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        Dúvidas? Contacte-nos! <strong>931 198 604</strong>
      </a>
    </div>
  </div>

  <header class="site-header">
    <div class="wrap site-header__inner">
      <button class="nav-toggle" aria-label="Abrir menu" aria-expanded="false" aria-controls="mobile-drawer">
        <span class="nav-toggle__bars" aria-hidden="true"><span></span><span></span><span></span></span>
      </button>
      <a href="{{ routes.root_url }}" class="site-header__logo">
        {% if settings.logo != blank %}
          <img src="{{ settings.logo | image_url: width: 300 }}" alt="{{ shop.name }}">
        {% else %}
          <img src="{{ 'huko-logo.svg' | asset_url }}" alt="{{ shop.name }}">
        {% endif %}
      </a>
      <nav class="site-nav">
        {% for link in linklists.main-menu.links %}
          {%- if link.links.size > 0 -%}
            <div class="nav-item nav-item--parent">
              <a href="{{ link.url }}" class="nav-item__link" aria-haspopup="true" aria-expanded="false">
                {{ link.title }}
                <svg class="nav-item__caret" width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true"><path d="M2 3.5 5 6.5 8 3.5" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
              {%- assign has_any_sub = false -%}
              {%- for child in link.links -%}{%- if child.links.size > 0 -%}{%- assign has_any_sub = true -%}{%- endif -%}{%- endfor -%}
              <div class="nav-mega{% if has_any_sub %} nav-mega--split{% endif %}" role="menu">
                <div class="nav-mega__l2">
                  {%- for child in link.links -%}
                    <a href="{{ child.url }}" class="nav-mega__l2link{% if child.links.size > 0 %} has-sub{% endif %}"
                       {% if child.links.size > 0 %}data-mega-index="{{ forloop.index0 }}"{% endif %} role="menuitem">
                      <span>{{ child.title }}</span>
                      {%- if child.links.size > 0 -%}
                        <svg class="nav-mega__l2caret" width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true"><path d="M3.5 2 6.5 5 3.5 8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                      {%- endif -%}
                    </a>
                  {%- endfor -%}
                </div>
                {%- if has_any_sub -%}
                  <div class="nav-mega__panel">
                    {%- for child in link.links -%}
                      {%- if child.links.size > 0 -%}
                        <div class="nav-mega__sub" data-mega-panel="{{ forloop.index0 }}">
                          <span class="nav-mega__sub-title">{{ child.title }}</span>
                          {%- for grandchild in child.links -%}
                            <a href="{{ grandchild.url }}" class="nav-mega__sublink" role="menuitem">{{ grandchild.title }}</a>
                          {%- endfor -%}
                        </div>
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                {%- endif -%}
              </div>
            </div>
          {%- else -%}
            <div class="nav-item">
              <a href="{{ link.url }}" class="nav-item__link">{{ link.title }}</a>
            </div>
          {%- endif -%}
        {% endfor %}
      </nav>
      <div class="header-icons">
        <a href="{{ routes.search_url }}" aria-label="Pesquisar"><svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke-width="1.6"><circle cx="11" cy="11" r="7"/><line x1="16.5" y1="16.5" x2="21" y2="21"/></svg></a>
        <a href="{{ routes.account_url }}" aria-label="Conta"><svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke-width="1.6"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-6.5 8-6.5s8 2.5 8 6.5"/></svg></a>
        <a href="{{ routes.cart_url }}" class="cart-link" aria-label="Carrinho">
          <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke-width="1.6"><path d="M5 8h14l-1.2 12H6.2L5 8z"/><path d="M8.5 8V6.5a3.5 3.5 0 0 1 7 0V8"/></svg>
          {% if cart.item_count > 0 %}<span class="cart-count">{{ cart.item_count }}</span>{% endif %}
        </a>
      </div>
    </div>
  </header>

  <div class="mobile-drawer" id="mobile-drawer" aria-hidden="true">
    <div class="mobile-drawer__overlay" data-drawer-close></div>
    <aside class="mobile-drawer__panel" role="dialog" aria-modal="true" aria-label="Menu de navegação">
      <div class="mobile-drawer__head">
        <span class="mobile-drawer__title">Menu</span>
        <button class="mobile-drawer__close" aria-label="Fechar menu" data-drawer-close>
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><line x1="6" y1="6" x2="18" y2="18"/><line x1="18" y1="6" x2="6" y2="18"/></svg>
        </button>
      </div>
      <nav class="mobile-nav">
        {% for link in linklists.main-menu.links %}
          {%- if link.links.size > 0 -%}
            <div class="mobile-nav__group">
              <div class="mobile-nav__row">
                <a href="{{ link.url }}" class="mobile-nav__link">{{ link.title }}</a>
                <button class="mobile-nav__expand" aria-label="Mostrar subcategorias de {{ link.title }}" aria-expanded="false">
                  <svg width="14" height="14" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 3.5 5 6.5 8 3.5"/></svg>
                </button>
              </div>
              <div class="mobile-nav__sub">
                <div class="mobile-nav__sub-inner">
                  {%- for child in link.links -%}
                    {%- if child.links.size > 0 -%}
                      <div class="mobile-nav__group mobile-nav__group--2">
                        <div class="mobile-nav__row">
                          <a href="{{ child.url }}" class="mobile-nav__sublink mobile-nav__sublink--parent">{{ child.title }}</a>
                          <button class="mobile-nav__expand" aria-label="Mostrar subcategorias de {{ child.title }}" aria-expanded="false">
                            <svg width="13" height="13" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 3.5 5 6.5 8 3.5"/></svg>
                          </button>
                        </div>
                        <div class="mobile-nav__sub">
                          <div class="mobile-nav__sub-inner">
                            {%- for grandchild in child.links -%}
                              <a href="{{ grandchild.url }}" class="mobile-nav__sublink mobile-nav__sublink--3">{{ grandchild.title }}</a>
                            {%- endfor -%}
                          </div>
                        </div>
                      </div>
                    {%- else -%}
                      <a href="{{ child.url }}" class="mobile-nav__sublink">{{ child.title }}</a>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              </div>
            </div>
          {%- else -%}
            <a href="{{ link.url }}" class="mobile-nav__link mobile-nav__link--solo">{{ link.title }}</a>
          {%- endif -%}
        {% endfor %}
      </nav>
    </aside>
  </div>

  <main>{{ content_for_layout }}</main>

  <section class="newsletter">
    <div class="newsletter__inner">
      <div class="eyebrow">Junta-te à matilha</div>
      <h2 class="serif">Novidades, lançamentos e <em>10% de desconto</em> na primeira compra</h2>
      <p>Sem spam. Apenas o essencial, uma vez por mês.</p>
      {% form 'customer' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input type="email" name="contact[email]" placeholder="O teu email" required>
        <button type="submit">Receber novidades</button>
      {% endform %}
    </div>
  </section>

  <footer class="site-footer">
    <div class="wrap">
      <div class="site-footer__cols">
        <div class="site-footer__brand">
          <img src="{{ 'huko-logo-light.svg' | asset_url }}" alt="{{ shop.name }}">
          <p>Acessórios premium para cães e gatos. Selecionados com carinho, enviados com rapidez.</p>
        </div>
        <div>
          <h4>Loja</h4>
          {% for link in linklists.main-menu.links limit: 4 %}<a href="{{ link.url }}">{{ link.title }}</a>{% endfor %}
        </div>
        <div>
          <h4>Apoio ao cliente</h4>
          {% for link in linklists.footer.links %}{% unless link.title == 'Busca' %}<a href="{{ link.url }}">{{ link.title }}</a>{% endunless %}{% endfor %}
          <a href="tel:+351931198604" class="footer-phone">
            <svg class="footer-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.362 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.338 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            931 198 604
          </a>
          <a href="mailto:geral@hukopets.com" class="footer-phone">
            <svg class="footer-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 6-10 7L2 6"/></svg>
            geral@hukopets.com
          </a>
          <a href="https://wa.me/351931198604" class="footer-phone" target="_blank" rel="noopener">
            <svg class="footer-icon footer-icon--whatsapp" width="14" height="14" viewBox="0 0 32 32" fill="#fff" aria-hidden="true"><path d="M16 0C7.163 0 0 7.163 0 16c0 2.837.744 5.5 2.05 7.813L0 32l8.417-2.02A15.93 15.93 0 0 0 16 32c8.837 0 16-7.163 16-16S24.837 0 16 0zm0 29.09c-2.55 0-4.95-.68-7.02-1.87l-.5-.3-5 1.2 1.23-4.87-.33-.5A13.06 13.06 0 0 1 2.91 16C2.91 8.77 8.77 2.91 16 2.91S29.09 8.77 29.09 16 23.23 29.09 16 29.09zm7.13-9.78c-.39-.2-2.3-1.13-2.66-1.26-.36-.13-.62-.2-.88.2-.26.39-1 1.26-1.23 1.52-.23.26-.45.29-.84.1-.39-.2-1.63-.6-3.1-1.9-1.15-1.02-1.92-2.28-2.15-2.67-.23-.39-.02-.6.17-.8.17-.17.39-.45.58-.68.2-.23.26-.39.39-.65.13-.26.06-.49-.03-.68-.1-.2-.88-2.13-1.2-2.92-.32-.77-.65-.66-.88-.67h-.75c-.26 0-.68.1-1.04.49-.36.39-1.36 1.33-1.36 3.24s1.39 3.76 1.58 4.02c.2.26 2.73 4.17 6.62 5.85.93.4 1.65.64 2.22.82.93.3 1.78.26 2.45.16.75-.11 2.3-.94 2.62-1.85.32-.9.32-1.68.23-1.85-.1-.16-.36-.26-.75-.46z"/></svg>
            WhatsApp
          </a>
        </div>
        <div>
          <h4>HUKO</h4>
          <a href="/pages/sobre-nos">Sobre nós</a>
          {% if shop.refund_policy %}<a href="{{ shop.refund_policy.url }}">Política de devolução e reembolso</a>{% endif %}
          {% if shop.privacy_policy %}<a href="{{ shop.privacy_policy.url }}">Política de privacidade</a>{% endif %}
          {% if shop.terms_of_service %}<a href="{{ shop.terms_of_service.url }}">Termos de serviço</a>{% endif %}
          {% if shop.shipping_policy %}<a href="{{ shop.shipping_policy.url }}">Política de envio</a>{% endif %}
          {% for policy in shop.policies %}
            {% if policy.url contains 'contact-information' %}<a href="{{ policy.url }}">Informações de contacto</a>{% endif %}
            {% if policy.url contains 'legal-notice' %}<a href="{{ policy.url }}">Aviso legal</a>{% endif %}
          {% endfor %}
        </div>
      </div>
      <div class="site-footer__base">
        <small>© {{ 'now' | date: '%Y' }} {{ shop.name }}. Todos os direitos reservados.</small>
        <div class="pay">
          {%- assign payment_types = 'visa,master,maestro,union_pay,apple_pay,google_pay,klarna,multibanco' | split: ',' -%}
          {%- for type in payment_types -%}
            {{ type | payment_type_svg_tag: class: 'pay__icon' }}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </footer>

  <script>
    (function () {
      var drawer = document.getElementById('mobile-drawer');
      if (!drawer) return;
      var toggle = document.querySelector('.nav-toggle');
      var body = document.body;

      function openDrawer() {
        drawer.classList.add('is-open');
        drawer.setAttribute('aria-hidden', 'false');
        if (toggle) toggle.setAttribute('aria-expanded', 'true');
        body.classList.add('drawer-open');
      }
      function closeDrawer() {
        drawer.classList.remove('is-open');
        drawer.setAttribute('aria-hidden', 'true');
        if (toggle) toggle.setAttribute('aria-expanded', 'false');
        body.classList.remove('drawer-open');
      }

      if (toggle) toggle.addEventListener('click', openDrawer);
      drawer.querySelectorAll('[data-drawer-close]').forEach(function (el) {
        el.addEventListener('click', closeDrawer);
      });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && drawer.classList.contains('is-open')) closeDrawer();
      });

      drawer.querySelectorAll('.mobile-nav__expand').forEach(function (btn) {
        btn.addEventListener('click', function (e) {
          e.preventDefault();
          e.stopPropagation();
          var group = btn.closest('.mobile-nav__group');
          var isOpen = group.classList.toggle('is-expanded');
          btn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
        });
      });
    })();

    // Mega-menu desktop: o painel do 3º nível segue a categoria de 2º nível sob o rato
    (function () {
      document.querySelectorAll('.nav-mega--split').forEach(function (mega) {
        var links = mega.querySelectorAll('.nav-mega__l2link.has-sub');
        var panels = mega.querySelectorAll('.nav-mega__sub');
        if (!links.length || !panels.length) return;
        function activate(index) {
          panels.forEach(function (p) { p.classList.toggle('is-active', p.dataset.megaPanel === index); });
          links.forEach(function (l) { l.classList.toggle('is-active', l.dataset.megaIndex === index); });
        }
        links.forEach(function (l) {
          l.addEventListener('mouseenter', function () { activate(l.dataset.megaIndex); });
          l.addEventListener('focus', function () { activate(l.dataset.megaIndex); });
        });
        activate(links[0].dataset.megaIndex);
      });
    })();
  </script>
</body>
</html>
