{%- comment -%}
  Painel de resultados da pesquisa. Fica vazio no carregamento da página: o
  conteúdo é a secção "predictive-search" renderizada pelo servidor e injetada
  por search.js, para que os preços e a formatação venham do Liquid.
{%- endcomment -%}
<div class="search-panel" id="search-panel" data-search-panel role="region" aria-label="Resultados da pesquisa" aria-hidden="true">
  <div class="wrap">
    <div class="search-panel__card">
      <button type="button" class="search-panel__close" data-search-close aria-label="Fechar resultados">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><line x1="6" y1="6" x2="18" y2="18"/><line x1="18" y1="6" x2="6" y2="18"/></svg>
      </button>
      <div class="search-panel__body" data-search-results aria-live="polite"></div>
    </div>
  </div>
</div>
