{%- comment -%}
  Devolve (em cêntimos) o preço mais baixo acima de 0 de uma lista de produtos.
  Parâmetros: products (lista), title_has (opcional: só produtos cujo título contém este texto)
  Uso: {%- capture x -%}{% render 'hv-min-price', products: c.products %}{%- endcapture -%}
{%- endcomment -%}
{%- assign hv_min = 0 -%}
{%- for p in products -%}
  {%- if title_has == blank or p.title contains title_has -%}
    {%- if p.price_min > 0 -%}
      {%- if hv_min == 0 or p.price_min < hv_min -%}{%- assign hv_min = p.price_min -%}{%- endif -%}
    {%- endif -%}
  {%- endif -%}
{%- endfor -%}
{{- hv_min -}}
