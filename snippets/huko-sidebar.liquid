{%- liquid
  assign sidebar_menu = linklists['main-menu']
-%}
<aside class="huko-sidebar" id="hukoSidebar" aria-label="Categorias">
  <nav class="huko-sidebar__nav">
    <p class="huko-sidebar__label">Categorias</p>
    <ul>
      {%- for link in sidebar_menu.links -%}
        {%- unless link.title == 'Início' -%}
          <li class="huko-sidebar__item{% if link.active %} is-active{% endif %}">
            <a href="{{ link.url }}" class="huko-sidebar__link{% if link.active %} is-active{% endif %}">
              {{- link.title -}}
            </a>
            {%- if link.links.size > 0 -%}
              <ul class="huko-sidebar__sub">
                {%- for child in link.links -%}
                  <li>
                    <a href="{{ child.url }}" class="huko-sidebar__sub-link{% if child.active %} is-active{% endif %}">
                      {{- child.title -}}
                    </a>
                    {%- if child.links.size > 0 -%}
                      <ul class="huko-sidebar__sub huko-sidebar__sub--l3">
                        {%- for grandchild in child.links -%}
                          <li>
                            <a href="{{ grandchild.url }}" class="huko-sidebar__sub-link{% if grandchild.active %} is-active{% endif %}">
                              {{- grandchild.title -}}
                            </a>
                          </li>
                        {%- endfor -%}
                      </ul>
                    {%- endif -%}
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </li>
        {%- endunless -%}
      {%- endfor -%}
    </ul>
  </nav>
</aside>

<button class="huko-sidebar-toggle" id="hukoSidebarToggle" aria-expanded="false" aria-controls="hukoSidebar" type="button">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" width="18" height="18"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
  Categorias
</button>
<div class="huko-sidebar-scrim" id="hukoSidebarScrim"></div>

<script>
(function(){
  var btn    = document.getElementById('hukoSidebarToggle');
  var aside  = document.getElementById('hukoSidebar');
  var scrim  = document.getElementById('hukoSidebarScrim');
  if(!btn) return;

  function open(){
    aside.classList.add('is-open');
    scrim.classList.add('is-open');
    btn.setAttribute('aria-expanded','true');
    document.body.style.overflow = 'hidden';
  }
  function close(){
    aside.classList.remove('is-open');
    scrim.classList.remove('is-open');
    btn.setAttribute('aria-expanded','false');
    document.body.style.overflow = '';
  }

  btn.addEventListener('click', function(){
    aside.classList.contains('is-open') ? close() : open();
  });
  scrim.addEventListener('click', close);
})();
</script>
